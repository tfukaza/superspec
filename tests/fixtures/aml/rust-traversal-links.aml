<architecture version="1" id="traversal-links">
  <profile id="lower-profile" points="0 0; 4 0; 4 4; 0 4"/>
  <profile id="upper-profile" points="4 0; 8 0; 8 4; 4 4"/>
  <slab id="lower" profile="lower-profile" thickness="0.2" playable="true"/>
  <slab id="upper" profile="upper-profile" elevation="3" thickness="0.2" playable="true"/>
  <marker id="bottom" kind="attacker_spawn" position="2 2 0" element="lower"/>
  <marker id="top" kind="objective" position="6 2 3" element="upper"/>
  <player radius="0.25" height="1.8" step="0.4" ladder="true"/>
  <link id="ladder-up" kind="ladder" ability="ladder" from="3.5 2 0" to="4.5 2 3" from-area="lower" to-area="upper" bidirectional="false"/>
  <route id="up" from="bottom" to="top"/>
  <route id="down" from="top" to="bottom"/>
</architecture>
