{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-window",
  "parameters": {
    "width": {"type": "number", "default": 1.2, "min": 0.4, "max": 4, "unit": "m"},
    "height": {"type": "number", "default": 1.4, "min": 0.4, "max": 3, "unit": "m"},
    "kind": {"type": "choice", "default": "casement", "choices": ["casement", "slider", "timber", "louver"]},
    "seed": {"type": "integer", "default": 0, "min": 0, "max": 100000000},
    "hood": {"type": "boolean", "default": true},
    "recess": {"type": "number", "default": 0.22, "min": 0.05, "max": 0.6, "unit": "m"},
    "frame": {"type": "color", "default": "#2f4f43"},
    "trim": {"type": "color", "default": "#ffffff"},
    "lit": {"type": "boolean", "default": false},
    "transom": {"type": "number", "default": 0.84, "min": 0.5, "max": 0.95},
    "glazing": {"type": "boolean", "default": true},
    "bars": {"type": "boolean", "default": false},
    "barsPattern": {"type": "choice", "default": "bars", "choices": ["bars", "grid", "diamond"]},
    "barsShare": {"type": "number", "default": 1, "min": 0.1, "max": 1},
    "storage": {"type": "number", "default": 0, "min": 0, "max": 1},
    "openChance": {"type": "number", "default": 0.3, "min": 0, "max": 8},
    "lightWidth": {"type": "number", "default": 0.5, "min": 0.2, "max": 2, "unit": "m"},
    "midRail": {"type": "boolean", "default": false},
    "louvre": {"type": "choice", "default": "none", "choices": ["none", "left", "right"]},
    "handles": {"type": "boolean", "default": true},
    "glow": {"type": "color", "default": "#ffe7ad"},
    "room": {"type": "number", "default": 2.6, "min": 0, "max": 6, "unit": "m"}
  },
  "parts": [
    {
      "id": "window",
      "generator": {"kind": "native", "name": "kowloon/window",
        "parameters": {"kind": {"parameter": "kind"}, "width": {"parameter": "width"}, "height": {"parameter": "height"},
                       "seed": {"parameter": "seed"}, "hood": {"parameter": "hood"}, "recess": {"parameter": "recess"},
                       "frame": {"parameter": "frame"}, "trim": {"parameter": "trim"}, "lit": {"parameter": "lit"},
                       "transom": {"parameter": "transom"}, "glazing": {"parameter": "glazing"}, "storage": {"parameter": "storage"},
                       "openChance": {"parameter": "openChance"}, "lightWidth": {"parameter": "lightWidth"}, "midRail": {"parameter": "midRail"},
                       "louvre": {"parameter": "louvre"}, "handles": {"parameter": "handles"}, "glow": {"parameter": "glow"},
                       "room": {"expr": "select(lit * (room >= 0.5), room, 0)"}}},
      "slots": {"paint": "frame", "glass": "glass", "pane": "pane", "interior-lit": "interior-lit", "tube-light": "tube-light", "room-lit": "room-lit", "metal": "metal", "concrete": "concrete", "stock": "stock", "timber": "timber", "shop-timber": "shop-timber"}
    },
    {
      "id": "bars",
      "when": "bars",
      "generator": {"kind": "native", "name": "kowloon/security-bars",
        "parameters": {"pattern": {"parameter": "barsPattern"}, "width": {"expr": "width + 0.12"}, "height": {"expr": "height + 0.1"}, "share": {"parameter": "barsShare"}}},
      "placement": {"position": [0, -0.06, -0.04]}
    }
  ],
  "features": [
    {"name": "sill", "part": "window", "points": [["-width / 2", 0, 0], ["width / 2", 0, 0]], "width": 0.06},
    {"name": "head", "part": "window", "width": "select(kind == 2, 0.065, 0.045)",
     "points": [["-width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}], ["width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}]]},
    {"name": "jamb", "part": "window", "width": "select(kind == 2, 0.065, 0.045)",
     "points": [["-width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}], ["-width / 2", "select(recess > 0, -0.035, -0.07)", 0]]},
    {"name": "jamb", "part": "window", "width": "select(kind == 2, 0.065, 0.045)",
     "points": [["width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}], ["width / 2", "select(recess > 0, -0.035, -0.07)", 0]]},
    {"name": "glass", "part": "window", "closed": true, "when": "glazing * (storage <= 0) * (1 - lit)",
     "points": [["select(kind == 2, 0.065, 0.045) - width / 2", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "select(kind == 2, 0.065, 0.045)"],
                ["width / 2 - select(kind == 2, 0.065, 0.045)", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "select(kind == 2, 0.065, 0.045)"],
                ["width / 2 - select(kind == 2, 0.065, 0.045)", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "height - select(kind == 2, 0.065, 0.045)"],
                ["select(kind == 2, 0.065, 0.045) - width / 2", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "height - select(kind == 2, 0.065, 0.045)"]]},
    {"name": "runoff-head", "part": "window", "width": "select(kind == 2, 0.065, 0.045)",
     "points": [["-width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}], ["width / 2", "select(recess > 0, -0.035, -0.07)", {"parameter": "height"}]],
     "zone": {"length": {"parameter": "height"}, "depth": "select(kind == 1, 0.018, 0.03)", "u0": "0 - width / 2"}},
    {"name": "runoff-glass", "part": "window", "when": "glazing * (storage <= 0) * (1 - lit)",
     "points": [["-width / 2", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "height - select(kind == 2, 0.065, 0.045)"],
                ["width / 2", "select(kind == 1, -0.001, select(kind == 3, -0.01, 0.01)) + select(recess > 0, 0, -0.035)", "height - select(kind == 2, 0.065, 0.045)"]],
     "zone": {"length": "height - 2 * select(kind == 2, 0.065, 0.045)", "depth": "select(kind == 1, 0.02, select(kind == 3, 0.03, 0.012))", "u0": "0 - width / 2"}}
  ],
  "layers": {
    "frame": [
      {"entry": "kowloon-grime-streaks.material.ts", "parameters": {"strength": 0.6, "color": [0.22, 0.2, 0.16], "streakLength": 0.5, "period": 1.1, "variety": 0.6, "lip": 1, "lipDepth": 0.045}, "seed": 21, "follow": {"zone": "runoff-head"}},
      {"entry": "kowloon-dust-streaks.material.ts", "parameters": {"strength": 1, "streakLength": 0.12, "period": 0.6, "film": 0.9, "filmDepth": 0.06, "color": [0.8, 0.78, 0.72]}, "seed": 22, "follow": {"zone": "runoff-head"}}
    ],
    "glass": [
      {"entry": "kowloon-dust-streaks.material.ts", "parameters": {"strength": 0.6, "streakLength": 0.8, "period": 1.1, "film": 0.35, "filmDepth": 0.1, "foot": 0.7, "opaque": 0.85, "color": [0.6, 0.58, 0.53]}, "seed": 23, "follow": {"zone": "runoff-glass"}}
    ]
  }
}
