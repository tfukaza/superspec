{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-duct-run",
  "parameters": {
    "length": {"type": "number", "default": 5, "min": 0.5, "max": 40, "unit": "m"},
    "direction": {"type": "number", "default": -1, "min": -1, "max": 1},
    "width": {"type": "number", "default": 0.3, "min": 0.15, "max": 0.8, "unit": "m"},
    "depth": {"type": "number", "default": 0.24, "min": 0.1, "max": 0.6, "unit": "m"},
    "standoff": {"type": "number", "default": 0.32, "min": 0.15, "max": 0.8, "unit": "m"},
    "tees": {"type": "number", "default": 2.1, "min": 0.6, "max": 10, "unit": "m"}
  },
  "parts": [
    {
      "id": "run",
      "generator": {
        "kind": "route",
        "section": {"kind": "rect", "width": {"parameter": "width"}, "height": {"parameter": "depth"}},
        "wallThickness": 0.004,
        "points": [[0, "-standoff", 0], ["direction * length", "-standoff", 0]],
        "up": [0, 0, 1],
        "capped": true,
        "fittings": [
          {"kind": "flange", "id": "seam", "at": {"every": 1.2, "inset": 0.5}, "overhang": 0.02, "thickness": 0.018},
          {"kind": "bracket", "id": "bracket", "at": {"every": 1.6, "inset": 0.6}, "reach": "standoff - depth / 2", "direction": [0, 1, 0], "width": 0.04, "thickness": 0.006},
          {"kind": "tee", "id": "drop", "at": {"every": {"parameter": "tees"}, "inset": 0.9}, "direction": [0, 1, 0], "length": {"parameter": "standoff"}}
        ]
      },
      "slots": {"body": "galvanized", "fitting": "galvanized", "bracket": "steel", "bolt": "steel", "end": "galvanized"}
    }
  ]
}
