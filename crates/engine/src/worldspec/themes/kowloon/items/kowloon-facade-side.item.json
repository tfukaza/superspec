{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-facade-side",
  "parameters": {
    "u0": {"type": "number", "default": 0, "min": -1000, "max": 1000, "unit": "m"},
    "paint": {"type": "color", "default": "#c0b49e"},
    "peeling": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "width": {"type": "number", "default": 9, "min": 0.1, "max": 30, "unit": "m"},
    "tileStrip": {"type": "boolean", "default": false},
    "tileStart": {"type": "boolean", "default": false},
    "tileEnd": {"type": "boolean", "default": false},
    "copingFlush": {"type": "boolean", "default": false},
    "arris": {"type": "number", "default": 0, "min": 0, "max": 0.05, "unit": "m"},
    "arrisStart": {"type": "number", "default": 0, "min": 0, "max": 2},
    "arrisEnd": {"type": "number", "default": 0, "min": 0, "max": 2},
    "floors": {"type": "integer", "default": 4, "min": 1, "max": 12},
    "storyHeight": {"type": "number", "default": 3.0, "min": 2.6, "max": 4.5, "unit": "m"},
    "groundHeight": {"type": "number", "default": 3.35, "min": 2.6, "max": 6, "unit": "m"},
    "thickness": {"type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "unit": "m"},
    "bayWidth": {"type": "number", "default": 2.1, "min": 1.0, "max": 4, "unit": "m"},
    "edge": {"type": "number", "default": 0.9, "min": 0.2, "max": 2, "unit": "m"},
    "windowWidth": {"type": "number", "default": 1.1, "min": 0.5, "max": 2.5, "unit": "m"},
    "windowHeight": {"type": "number", "default": 1.3, "min": 0.5, "max": 2.4, "unit": "m"},
    "sill": {"type": "number", "default": 0.95, "min": 0.3, "max": 1.6, "unit": "m"},
    "windowKind": {"type": "choice", "default": "casement", "choices": ["casement", "slider", "timber", "louver"]},
    "frame": {"type": "color", "default": "#2f4f43"},
    "seed": {"type": "integer", "default": 1, "min": 0, "max": 100000},
    "windows": {"type": "boolean", "default": true},
    "windowChance": {"type": "number", "default": 1, "min": 0, "max": 1},
    "backDoor": {"type": "boolean", "default": false},
    "backDoorAt": {"type": "number", "default": 0, "min": 0, "max": 40, "unit": "m"},
    "backDoorWidth": {"type": "number", "default": 0.9, "min": 0.6, "max": 2, "unit": "m"},
    "spansPlan": {"type": "grid", "default": []},
    "windowsPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "window", "barred", "grille"]},
    "fixturesPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "aircon", "split", "cage", "rack", "plants", "caged-aircon"]},
    "fixturesAt": {"type": "grid", "default": []},
    "cagedChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "openChance": {"type": "number", "default": 0.3, "min": 0, "max": 8},
    "opensPlan": {"type": "grid", "default": []},
    "litChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "litsPlan": {"type": "grid", "default": []},
    "narrowBay": {"type": "number", "default": 0, "min": 0, "max": 10, "unit": "m"},
    "narrowLightWidth": {"type": "number", "default": 0.7, "min": 0.2, "max": 2, "unit": "m"},
    "louvreChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "louvresPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "left", "right"]},
    "shopPlan": {"type": "grid", "default": [], "choices": ["auto", "shop", "shutter", "gate", "door", "service", "open"]},
    "awningPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "awning", "tarp", "striped"]},
    "awningSagPlan": {"type": "grid", "default": []},
    "awningStripePlan": {"type": "grid", "default": []},
    "tradePlan": {"type": "grid", "default": [], "choices": ["auto", "provisions", "grocer", "greengrocer", "hardware", "herbalist"]},
    "shopSpans": {"type": "grid", "default": []},
    "shopDepth": {"type": "number", "default": 3.1, "min": 2.4, "max": 20, "unit": "m"},
    "cornerStart": {"type": "number", "default": 0, "min": 0, "max": 40, "unit": "m"},
    "cornerDepth": {"type": "number", "default": 0, "min": 0, "max": 40, "unit": "m"},
    "clutterPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "crates", "cartons", "mixed", "crates-left", "cartons-left", "mixed-left", "crates-right", "cartons-right", "mixed-right"]},
    "gateColor": {"type": "color", "default": "#647a6b"},
    "gateBars": {"type": "number", "default": 1, "min": 0.5, "max": 3},
    "gateBacking": {"type": "number", "default": 0, "min": 0, "max": 2},
    "doorPanels": {"type": "integer", "default": 0, "min": 0, "max": 4},
    "backDoorColor": {"type": "color", "default": "#2f4f43"},
    "backDoorLouvres": {"type": "boolean", "default": true},
    "shopSigns": {"type": "boolean", "default": true},
    "dado": {"type": "number", "default": 0, "min": 0, "max": 2, "unit": "m"},
    "awningLower": {"type": "number", "default": 0, "min": 0, "max": 1.2, "unit": "m"},
    "spandrelsPlan": {"type": "grid", "default": []},
    "fullCages": {"type": "boolean", "default": false},
    "cageColor": {"type": "color", "default": "#c9c3b2"},
    "cageRust": {"type": "number", "default": 0.3, "min": 0, "max": 1},
    "cageBar": {"type": "number", "default": 0.008, "min": 0.004, "max": 0.05, "unit": "m"},
    "cageRail": {"type": "number", "default": 0.02, "min": 0.008, "max": 0.08, "unit": "m"},
    "cageSpacing": {"type": "number", "default": 0.09, "min": 0.04, "max": 0.5, "unit": "m"},
    "shutterColor": {"type": "color", "default": "#5a6f68"},
    "doorColor": {"type": "color", "default": "#2f4f43"},
    "doorsPlan": {"type": "grid", "default": []},
    "canopiesPlan": {"type": "grid", "default": []},
    "canopyChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "pipePlan": {"type": "grid", "default": []},
    "conduitPlan": {"type": "grid", "default": []},
    "conduits": {"type": "integer", "default": 0, "min": 0, "max": 6},
    "conduitColor": {"type": "color", "default": "#4d5048"},
    "glazing": {"type": "boolean", "default": true},
    "hoods": {"type": "boolean", "default": true},
    "plinth": {"type": "number", "default": 0, "min": 0, "max": 2, "unit": "m"},
    "ledge": {"type": "boolean", "default": false},
    "miterStart": {"type": "number", "default": 0, "min": 0, "max": 4},
    "miterEnd": {"type": "number", "default": 0, "min": 0, "max": 4},
    "balconyFrom": {"type": "number", "default": 0.6, "min": 0, "max": 40, "unit": "m"},
    "balconyTo": {"type": "number", "default": -0.6, "min": -40, "max": 40, "unit": "m"},
    "balconyDepth": {"type": "number", "default": 0.85, "min": 0.3, "max": 3, "unit": "m"},
    "balconyBrackets": {"type": "number", "default": 1.85, "min": 0, "max": 20, "unit": "m"},
    "balconyFan": {"type": "number", "default": -1, "min": -1, "max": 40, "unit": "m"},
    "balconyPlants": {"type": "boolean", "default": true},
    "balcony": {"type": "boolean", "default": false},
    "balconyRail": {"type": "choice", "default": "steel", "choices": ["parapet", "steel"]},
    "tileBands": {"type": "boolean", "default": false},
    "cageChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "pipes": {"type": "integer", "default": 0, "min": 0, "max": 8},
    "airconChance": {"type": "number", "default": 0.5, "min": 0, "max": 1},
    "condenserChance": {"type": "number", "default": 0.35, "min": 0, "max": 1},
    "barsChance": {"type": "number", "default": 0.4, "min": 0, "max": 1},
    "ventChance": {"type": "number", "default": 0.25, "min": 0, "max": 1},
    "rackChance": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "plantChance": {"type": "number", "default": 0.12, "min": 0, "max": 1},
    "groundShops": {"type": "boolean", "default": true},
    "shopWidth": {"type": "number", "default": 3.0, "min": 1.6, "max": 12, "unit": "m"},
    "awningChance": {"type": "number", "default": 0.4, "min": 0, "max": 1},
    "bands": {"type": "boolean", "default": true},
    "downpipe": {"type": "boolean", "default": true},
    "riser": {"type": "boolean", "default": true},
    "riserRight": {"type": "boolean", "default": true},
    "ductRun": {"type": "boolean", "default": false},
    "runLength": {"type": "number", "default": 0.6, "min": 0.2, "max": 0.95},
    "ducts": {"type": "integer", "default": 0, "min": 0, "max": 6},
    "parapet": {"type": "number", "default": 0.95, "min": 0.3, "max": 2, "unit": "m"},
    "door": {"type": "choice", "default": "auto", "choices": ["auto", "single", "double", "glazed", "steel"]},
    "transom": {"type": "choice", "default": "auto", "choices": ["auto", "glazed", "mesh", "none"]},
    "fitted": {"type": "boolean", "default": false},
    "lampStyle": {"type": "choice", "default": "bulkhead", "choices": ["bulkhead", "round"]},
    "shutterHead": {"type": "number", "default": 0.22, "min": 0.1, "max": 1, "unit": "m"},
    "shutterHeadRust": {"type": "number", "default": 0, "min": 0, "max": 1},
    "fascia": {"type": "boolean", "default": true},
    "meters": {"type": "boolean", "default": true},
    "cagesPlan": {"type": "grid", "default": [], "choices": ["auto", "plants", "washing", "storage", "mixed", "empty"]},
    "storagePlan": {"type": "grid", "default": []},
    "windowTransom": {"type": "number", "default": 0.84, "min": 0.5, "max": 0.95},
    "ventPlan": {"type": "grid", "default": []},
    "meterPlan": {"type": "grid", "default": []},
    "cablePlan": {"type": "grid", "default": []},
    "cables": {"type": "integer", "default": 0, "min": 0, "max": 12},
    "cornerRadius": {"type": "number", "default": 0, "min": 0, "max": 5, "unit": "m"},
    "pipeClips": {"type": "number", "default": 1.2, "min": 0, "max": 10, "unit": "m"}
  },
  "derived": {
    "upper": "1",
    "base": "groundHeight",
    "uppers": "floors - upper",
    "height": "base + uppers * storyHeight",
    "bays": "max(1, floor((width - edge * 2) / bayWidth))",
    "balconyEnd": "select(balconyTo > 0, balconyTo, width + balconyTo)",
    "doorBay": "1 + floor(random(seed, 14) * max(1, bays - 1))",
    "doorOn": "backDoor * (1 - groundShops) * select(backDoorAt > 0, 1, (bays >= 2) * (count(spansPlan, 0) == 0) * (bayWidth - windowWidth >= 0.8))",
    "doorWidth": "select(backDoorAt > 0, backDoorWidth, min(backDoorWidth, bayWidth - windowWidth - 0.14))",
    "doorX": "select(backDoorAt > 0, backDoorAt, (width - bays * bayWidth) / 2 + doorBay * bayWidth)",
    "pipeX": "select(riserRight, edge / 2, width - edge / 2)",
    "riserX": "select(riserRight, width - edge / 2, edge / 2)"
  },
  "parts": [
    {
      "id": "ground",
      "when": "groundShops",
      "generator": {"kind": "item", "entry": "kowloon-ground-floor.item.json",
        "parameters": {"u0": {"parameter": "u0"},"width": {"parameter": "width"}, "height": {"parameter": "groundHeight"}, "thickness": {"parameter": "thickness"},
                       "shopWidth": {"parameter": "shopWidth"}, "awningChance": {"parameter": "awningChance"}, "seed": {"parameter": "seed"},
                       "shopPlan": {"parameter": "shopPlan"}, "awningPlan": {"parameter": "awningPlan"},
                       "awningSagPlan": {"parameter": "awningSagPlan"}, "awningStripePlan": {"parameter": "awningStripePlan"},
                       "tradePlan": {"parameter": "tradePlan"}, "shopSpans": {"parameter": "shopSpans"}, "shopDepth": {"parameter": "shopDepth"},
                       "cornerStart": {"parameter": "cornerStart"}, "cornerDepth": {"parameter": "cornerDepth"}, "clutterPlan": {"parameter": "clutterPlan"}, "gateColor": {"parameter": "gateColor"},
                       "gateBars": {"parameter": "gateBars"}, "gateBacking": {"parameter": "gateBacking"}, "doorPanels": {"parameter": "doorPanels"},
                       "signs": {"parameter": "shopSigns"}, "plinth": {"parameter": "plinth"}, "dado": {"parameter": "dado"}, "awningLower": {"parameter": "awningLower"},
                       "shutterColor": {"parameter": "shutterColor"}, "doorColor": {"parameter": "doorColor"},
                       "door": {"parameter": "door"}, "transom": {"parameter": "transom"}, "fitted": {"parameter": "fitted"}, "lampStyle": {"parameter": "lampStyle"},
                       "shutterHead": {"parameter": "shutterHead"}, "shutterHeadRust": {"parameter": "shutterHeadRust"},
                       "fascia": {"parameter": "fascia"}, "meters": {"parameter": "meters"}, "meterPlan": {"parameter": "meterPlan"},
                       "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"},
                       "paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"}}}
    },
    {
      "id": "groundFloor",
      "when": "1 - groundShops",
      "generator": {"kind": "item", "entry": "kowloon-floor.item.json",
        "parameters": {"u0": {"parameter": "u0"},"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"parameter": "width"}, "height": {"parameter": "groundHeight"}, "thickness": {"parameter": "thickness"},
                       "z0": 0, "level": 0, "seed": {"parameter": "seed"},
                       "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"},
                       "spanPlan": {"element": "spansPlan", "at": "0"}, "windowPlan": {"element": "windowsPlan", "at": "0"}, "fixturePlan": {"element": "fixturesPlan", "at": "0"},
                       "windows": {"parameter": "windows"}, "windowChance": {"expr": "windowChance * 0.7"}, "bayWidth": {"parameter": "bayWidth"}, "edge": {"parameter": "edge"},
                       "windowWidth": {"parameter": "windowWidth"}, "windowHeight": {"parameter": "windowHeight"}, "sill": {"expr": "sill + 0.25"},
                       "windowKind": {"parameter": "windowKind"}, "frame": {"parameter": "frame"},
                       "airconChance": {"expr": "airconChance * 0.6"}, "condenserChance": {"expr": "condenserChance * 0.6"},
                       "barsChance": {"expr": "min(1, barsChance * 1.8)"}, "ventChance": {"parameter": "ventChance"},
                       "windowTransom": {"parameter": "windowTransom"}, "storage": {"expr": "cell(storagePlan, 0)"},
                       "fixtureAt": {"element": "fixturesAt", "at": "0"}, "cagedChance": {"parameter": "cagedChance"},
                       "openChance": {"parameter": "openChance"}, "openPlan": {"element": "opensPlan", "at": "0"},
                       "narrowBay": {"parameter": "narrowBay"}, "narrowLightWidth": {"parameter": "narrowLightWidth"},
                       "serviceDoorAt": {"derived": "doorX"}, "serviceDoorWidth": {"expr": "doorOn * doorWidth"},
                       "rackChance": 0, "plantChance": 0, "band": false, "glazing": {"parameter": "glazing"}, "hoods": {"parameter": "hoods"}, "plinth": {"parameter": "plinth"}, "dado": {"parameter": "dado"}}}
    },
    {
      "id": "floor",
      "repeat": [{"name": "j", "count": {"derived": "uppers"}}],
      "generator": {"kind": "item", "entry": "kowloon-floor.item.json",
        "parameters": {"u0": {"parameter": "u0"},"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"parameter": "width"}, "height": {"parameter": "storyHeight"}, "thickness": {"parameter": "thickness"},
                       "z0": {"expr": "base + j * storyHeight"}, "level": {"expr": "j + upper"}, "seed": {"parameter": "seed"},
                       "spanPlan": {"element": "spansPlan", "at": "j + 1"}, "windowPlan": {"element": "windowsPlan", "at": "j + 1"}, "fixturePlan": {"element": "fixturesPlan", "at": "j + 1"},
                       "windows": {"parameter": "windows"}, "windowChance": {"parameter": "windowChance"}, "bayWidth": {"parameter": "bayWidth"}, "edge": {"parameter": "edge"},
                       "windowWidth": {"parameter": "windowWidth"}, "windowHeight": {"parameter": "windowHeight"}, "sill": {"parameter": "sill"},
                       "windowKind": {"parameter": "windowKind"}, "frame": {"parameter": "frame"},
                       "airconChance": {"parameter": "airconChance"}, "condenserChance": {"parameter": "condenserChance"},
                       "barsChance": {"expr": "select((j == 0) * groundShops, barsChance, 0)"}, "ventChance": {"parameter": "ventChance"},
                       "rackChance": {"parameter": "rackChance"}, "plantChance": {"parameter": "plantChance"},
                       "tileBands": {"parameter": "tileBands"}, "tileStrip": {"parameter": "tileStrip"}, "tileStart": {"parameter": "tileStart"}, "tileEnd": {"parameter": "tileEnd"}, "spandrelPlan": {"element": "spandrelsPlan", "at": "j + 1"}, "cageFull": {"parameter": "fullCages"}, "cageColor": {"parameter": "cageColor"}, "cageRust": {"parameter": "cageRust"}, "cageBar": {"parameter": "cageBar"}, "cageRail": {"parameter": "cageRail"}, "cageSpacing": {"parameter": "cageSpacing"}, "cageChance": {"expr": "select(j == 1, cageChance, cageChance * 0.3)"},
                       "doorPlan": {"element": "doorsPlan", "at": "j + 1"}, "canopyPlan": {"element": "canopiesPlan", "at": "j + 1"}, "canopyChance": {"parameter": "canopyChance"}, "glazing": {"parameter": "glazing"}, "hoods": {"parameter": "hoods"},
                       "miterStart": {"parameter": "miterStart"}, "miterEnd": {"parameter": "miterEnd"},
                       "cagePlan": {"element": "cagesPlan", "at": "j + 1"}, "storage": {"expr": "cell(storagePlan, j + 1)"}, "windowTransom": {"parameter": "windowTransom"},
                       "fixtureAt": {"element": "fixturesAt", "at": "j + 1"}, "cagedChance": {"parameter": "cagedChance"},
                       "openChance": {"parameter": "openChance"}, "openPlan": {"element": "opensPlan", "at": "j + 1"},
                       "litChance": {"parameter": "litChance"}, "litPlan": {"element": "litsPlan", "at": "j + 1"},
                       "narrowBay": {"parameter": "narrowBay"}, "narrowLightWidth": {"parameter": "narrowLightWidth"},
                       "louvreChance": {"parameter": "louvreChance"}, "louvrePlan": {"element": "louvresPlan", "at": "j + 1"},
                       "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"},
                       "band": {"choose": [false, true], "by": "bands * (1 - (j == 0) * groundShops * fascia)"}}},
      "placement": {"position": [0, 0, "base + j * storyHeight"]}
    },
    {
      "id": "parapet",
      "generator": {"kind": "item", "entry": "kowloon-parapet.item.json",
        "parameters": {"u0": {"parameter": "u0"}, "z0": {"derived": "height"},"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"parameter": "width"}, "thickness": {"parameter": "thickness"}, "height": {"parameter": "parapet"},
                       "outlet": {"parameter": "downpipe"}, "outletX": {"derived": "pipeX"},
                       "ledge": {"parameter": "ledge"}, "miterStart": {"parameter": "miterStart"}, "miterEnd": {"parameter": "miterEnd"}, "copingFlush": {"parameter": "copingFlush"},
                       "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"}}},
      "placement": {"position": [0, 0, {"derived": "height"}]}
    },
    {
      "id": "balcony",
      "when": "balcony * (uppers >= 1) * (width >= 3)",
      "generator": {"kind": "native", "name": "kowloon/balcony",
        "parameters": {"width": {"expr": "balconyEnd - balconyFrom"}, "depth": {"parameter": "balconyDepth"}, "thickness": 0.27, "parapet": true, "parapet_height": 0.95,
                       "brackets": {"parameter": "balconyBrackets"}, "color": "#ffffff", "upstand": 0.465,
                       "rail": {"parameter": "balconyRail"}, "rail_color": {"parameter": "frame"}}},
      "placement": {"position": ["(balconyFrom + balconyEnd) / 2", 0, {"derived": "base"}]}
    },
    {
      "id": "balconyFan",
      "when": "balcony * (uppers >= 1) * (width >= 3) * (balconyFan >= 0)",
      "generator": {"kind": "native", "name": "kowloon/fan-divider",
        "parameters": {"reach": {"expr": "balconyDepth - 0.08"}, "height": 1.6, "color": {"parameter": "frame"}}},
      "placement": {"position": [{"parameter": "balconyFan"}, 0, "base + 0.02"]}
    },
    {
      "id": "balconyPlants",
      "when": "balcony * (uppers >= 1) * (width >= 3) * balconyPlants * (balconyEnd - balconyFrom >= 3)",
      "generator": {"kind": "native", "name": "kowloon/plants",
        "parameters": {"width": 1.7, "offset": {"expr": "balconyDepth - 0.26"}, "seed": {"expr": "seed * 1000 + 77"}}},
      "placement": {"position": ["balconyFrom + 1 + (balconyEnd - balconyFrom - 2) * (0.35 + 0.5 * random(seed, 21))", 0, "base + 0.01"]}
    },
    {
      "id": "drain",
      "repeat": [{"name": "k", "count": "count(pipePlan)"}],
      "generator": {"kind": "native", "name": "kowloon/downpipe",
        "parameters": {"height": {"expr": "height - 0.1"}, "radius": 0.043, "color": "#8f8a7c", "sides": 12, "hopper": true, "clips": {"parameter": "pipeClips"}}},
      "placement": {"position": ["cell(pipePlan, k)", 0, 0.02]}
    },
    {
      "id": "cable",
      "repeat": [{"name": "k", "count": "count(cablePlan)"}],
      "generator": {"kind": "native", "name": "kowloon/cable",
        "parameters": {"span": {"expr": "cell(cablePlan, k, 2) - cell(cablePlan, k, 0)"}, "rise": {"expr": "cell(cablePlan, k, 3) - cell(cablePlan, k, 1)"},
                       "sag": {"expr": "select(count(cablePlan, k) > 4, cell(cablePlan, k, 4), 0.2)"},
                       "out": {"expr": "select(count(cablePlan, k) > 5, max(0.03, cell(cablePlan, k, 5)), 0.03)"},
                       "count": {"expr": "select(count(cablePlan, k) > 6, clamp(round(cell(cablePlan, k, 6)), 1, 12), 1)"},
                       "corner": {"expr": "select(count(cablePlan, k) > 7, select(cell(cablePlan, k, 7) > 0, width - cell(cablePlan, k, 0), 0), 0)"},
                       "cornerRadius": {"expr": "select(count(cablePlan, k) > 7, max(0.02, cell(cablePlan, k, 7)), 0.25)"},
                       "boxes": {"choose": ["none", "start", "end", "both"], "by": "select(count(cablePlan, k) > 8, cell(cablePlan, k, 8), 0)"},
                       "seed": {"expr": "seed * 31 + k"}}},
      "placement": {"position": ["cell(cablePlan, k, 0)", 0, "cell(cablePlan, k, 1)"]}
    },
    {
      "id": "cableAuto",
      "repeat": [{"name": "k", "count": {"parameter": "cables"}}],
      "when": "(count(cablePlan) == 0) * (width >= 3) * (uppers >= 1)",
      "generator": {"kind": "native", "name": "kowloon/cable",
        "parameters": {"span": {"expr": "select((k == 0) * (cornerRadius > 0), 1 + 2 * random(seed, k, 61) + cornerRadius * 1.5708 + 1 + 2 * random(seed, k, 62), min(width * (0.92 - 0.5 * random(seed, k, 61)) - 0.2, 1.5 + 3.5 * random(seed, k, 62)))"},
                       "rise": {"expr": "0.3 * random(seed, k, 65) - 0.15"},
                       "sag": {"expr": "0.1 + 0.2 * random(seed, k, 66)"},
                       "count": {"expr": "1 + floor(random(seed, k, 67) * 2.5)"},
                       "corner": {"expr": "select((k == 0) * (cornerRadius > 0), 1 + 2 * random(seed, k, 61), 0)"},
                       "cornerRadius": {"expr": "max(0.02, cornerRadius)"},
                       "boxes": {"choose": ["start", "none", "both"], "by": "random(seed, k, 68) * 3"},
                       "seed": {"expr": "seed * 37 + k"}}},
      "placement": {"position": ["select((k == 0) * (cornerRadius > 0), width - 1 - 2 * random(seed, k, 61), width * (0.08 + 0.5 * random(seed, k, 61)))", 0,
                                 "base + (1 + floor(random(seed, k, 63) * uppers)) * storyHeight + 0.45 + 0.25 * random(seed, k, 64)"]}
    },
    {
      "id": "conduit",
      "repeat": [{"name": "k", "count": "count(conduitPlan)"}],
      "generator": {"kind": "native", "name": "kowloon/conduit",
        "parameters": {"rise": {"expr": "cell(conduitPlan, k, 2)"}, "run": {"expr": "cell(conduitPlan, k, 3)"}, "rise2": {"expr": "cell(conduitPlan, k, 4)"},
                       "endBox": {"expr": "select(count(conduitPlan, k) > 5, cell(conduitPlan, k, 5), 0)"}, "color": {"parameter": "conduitColor"}}},
      "placement": {"position": ["cell(conduitPlan, k, 0)", 0, "cell(conduitPlan, k, 1)"]}
    },
    {
      "id": "ventAt",
      "repeat": [{"name": "k", "count": "count(ventPlan)"}],
      "generator": {"kind": "native", "name": "kowloon/wall-vent",
        "parameters": {"width": {"expr": "select(count(ventPlan, k) > 2, cell(ventPlan, k, 2), 0.38)"}, "height": {"expr": "select(count(ventPlan, k) > 3, cell(ventPlan, k, 3), 0.23)"}}},
      "placement": {"position": ["cell(ventPlan, k, 0)", 0, "cell(ventPlan, k, 1)"]}
    },
    {
      "id": "wiring",
      "repeat": [{"name": "k", "count": {"parameter": "conduits"}}],
      "when": "count(conduitPlan) == 0",
      "generator": {"kind": "native", "name": "kowloon/conduit",
        "parameters": {"rise": {"expr": "base - 0.5 - 0.1 * k"}, "run": {"expr": "select(random(seed, k, 23) < 0.5, -1, 1) * min(bayWidth * (1 + floor(random(seed, k, 24) * 2)), width / 3)"},
                       "rise2": {"expr": "height - base + 0.3 - 0.4 * random(seed, k, 25)"}, "color": {"parameter": "conduitColor"}}},
      "placement": {"position": ["width * (0.35 + 0.3 * random(seed, k, 22))", 0, 0.2]}
    },
    {
      "id": "backDoor",
      "when": "doorOn",
      "generator": {"kind": "native", "name": "kowloon/back-door",
        "parameters": {"width": {"derived": "doorWidth"}, "height": 2.05, "recess": {"expr": "thickness - 0.02"},
                       "color": {"parameter": "backDoorColor"}, "louvres": {"parameter": "backDoorLouvres"}, "seed": {"expr": "seed * 1000 + 999"}}},
      "placement": {"position": [{"derived": "doorX"}, 0, 0.03]},
      "slots": {"paint": "frame", "pane": "pane", "metal": "metal", "concrete": "concrete"}
    },
    {
      "id": "backLamp",
      "when": "doorOn",
      "generator": {"kind": "native", "name": "kowloon/wall-lamp", "parameters": {"style": {"parameter": "lampStyle"}}},
      "placement": {"position": [{"derived": "doorX"}, 0, 2.32]}
    },
    {
      "id": "pipe",
      "repeat": [{"name": "k", "count": "max(0, bays - 1)"}],
      "when": "(pipes > 0) * (random(seed, k, 12) < pipes / max(1, bays - 1)) * (1 - doorOn * (abs((width - bays * bayWidth) / 2 + (k + 1) * bayWidth + 0.25 - doorX) < doorWidth / 2 + 0.12))",
      "generator": {"kind": "native", "name": "kowloon/downpipe",
        "parameters": {"height": {"expr": "height + 0.2"}, "radius": {"choose": [0.04, 0.05, 0.065], "by": "random(seed, k, 15) * 3"}, "color": "#8f8a7c"}},
      "placement": {"position": ["(width - bays * bayWidth) / 2 + (k + 1) * bayWidth + 0.25", 0, 0]}
    },
    {
      "id": "downpipe",
      "when": "downpipe",
      "generator": {"kind": "native", "name": "kowloon/downpipe", "parameters": {"height": {"expr": "height + 0.3"}, "color": "#8f8a7c", "clips": {"parameter": "pipeClips"}}},
      "placement": {"position": [{"derived": "pipeX"}, 0, 0]}
    },
    {
      "id": "riser",
      "when": "riser * (floors >= 2)",
      "generator": {"kind": "item", "entry": "kowloon-duct-riser.item.json",
        "parameters": {"floors": {"derived": "uppers"}, "storyHeight": {"parameter": "storyHeight"},
                       "height": {"derived": "height"}, "firstFloor": {"derived": "base"},
                       "base": {"expr": "select(groundShops, groundHeight + 0.25, 0.9)"}}},
      "placement": {"position": [{"derived": "riserX"}, 0, 0]}
    },
    {
      "id": "run",
      "when": "ductRun * riser * (floors >= 2)",
      "generator": {"kind": "item", "entry": "kowloon-duct-run.item.json",
        "parameters": {"length": {"expr": "runLength * (width - edge)"}, "direction": {"expr": "select(riserRight, -1, 1)"},
                       "tees": {"parameter": "bayWidth"}}},
      "placement": {"position": [{"derived": "riserX"}, 0, "height - 0.75"]}
    },
    {
      "id": "duct",
      "repeat": [{"name": "k", "count": "max(0, bays - 1)"}],
      "when": "(ducts > 0) * (uppers >= 2) * windows * (random(seed, k, 7) < ducts / max(1, bays - 1))",
      "generator": {"kind": "native", "name": "kowloon/riser-duct",
        "parameters": {"height": {"expr": "clamp(uppers * storyHeight - 1.6, 3, 20)"}}},
      "placement": {"position": ["(width - bays * bayWidth) / 2 + (k + 1) * bayWidth", 0, "base + 0.4"]}
    }
  ],
  "features": [
    {"name": "ledge", "part": "balcony", "points": [["balconyFrom", "-balconyDepth", "base + 0.46"], ["balconyEnd", "-balconyDepth", "base + 0.46"]],
     "when": "balcony * (uppers >= 1) * (width >= 3)", "zone": {"length": 0.75, "u0": "u0 + balconyFrom"}},
    {"name": "rust", "part": "drain-{k}", "repeat": {"name": "k", "count": "count(pipePlan)"}, "reach": "item", "within": 1,
     "points": [["cell(pipePlan,  k) + 0.045 - 0.035", -0.008, "base + 1.1 + 1.5 * random(seed,  k,  41)"], ["cell(pipePlan,  k) + 0.045 + 0.035", -0.008, "base + 1.1 + 1.5 * random(seed,  k,  41)"]], "zone": {"length": "(base + 1.1 + 1.5 * random(seed, k, 41)) - (base + 0.5 + 1.5 * random(seed, k, 41) - 0.5 * random(seed, k, 43))"}},
    {"name": "rust", "part": "drain-{k}", "repeat": {"name": "k", "count": "count(pipePlan)"}, "reach": "item", "within": 1,
     "points": [["cell(pipePlan,  k) - 0.045 - 0.035", -0.008, "base + 4.2 + 1.4 * random(seed,  k,  44)"], ["cell(pipePlan,  k) - 0.045 + 0.035", -0.008, "base + 4.2 + 1.4 * random(seed,  k,  44)"]], "zone": {"length": "(base + 4.2 + 1.4 * random(seed, k, 44)) - (base + 3.5 + 1.4 * random(seed, k, 44) - 0.5 * random(seed, k, 46))"}}
  ],
  "attachments": [
    {"name": "base-left", "position": [0, 0, 0], "direction": [0, -1, 0]},
    {"name": "base-right", "position": [{"parameter": "width"}, 0, 0], "direction": [0, -1, 0]},
    {"name": "roof", "position": ["width / 2", "thickness / 2", {"derived": "height"}], "direction": [0, 0, 1]}
  ]
}
