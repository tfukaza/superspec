{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-ground-floor",
  "parameters": {
    "u0": {"type": "number", "default": 0, "min": -1000, "max": 1000, "unit": "m"},
    "paint": {"type": "color", "default": "#c0b49e"},
    "peeling": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "width": {"type": "number", "default": 9, "min": 2, "max": 40, "unit": "m"},
    "height": {"type": "number", "default": 3.35, "min": 2.6, "max": 6, "unit": "m"},
    "thickness": {"type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "unit": "m"},
    "edge": {"type": "number", "default": 0.35, "min": 0.1, "max": 3, "unit": "m"},
    "shopWidth": {"type": "number", "default": 3.0, "min": 1.6, "max": 12, "unit": "m"},
    "seed": {"type": "integer", "default": 1, "min": 0, "max": 100000},
    "awningChance": {"type": "number", "default": 0.4, "min": 0, "max": 1},
    "shopPlan": {"type": "grid", "default": [], "choices": ["auto", "shop", "shutter", "gate", "door", "service", "open"]},
    "awningPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "awning", "tarp", "striped"]},
    "awningSagPlan": {"type": "grid", "default": []},
    "awningStripePlan": {"type": "grid", "default": []},
    "tradePlan": {"type": "grid", "default": [], "choices": ["auto", "provisions", "grocer", "greengrocer", "hardware", "herbalist"]},
    "shopSpans": {"type": "grid", "default": []},
    "shopDepth": {"type": "number", "default": 3.1, "min": 2.4, "max": 20, "unit": "m"},
    "cornerStart": {"type": "number", "default": 0, "min": 0, "max": 40, "unit": "m"},
    "cornerDepth": {"type": "number", "default": 0, "min": 0, "max": 40, "unit": "m"},
    "clutterPlan": {"type": "grid", "default": [], "choices": ["auto", "none", "crates", "cartons", "mixed", "crates-left", "cartons-left", "mixed-left", "crates-right", "cartons-right", "mixed-right"]},
    "gateColor": {"type": "color", "default": "#647a6b"},
    "gateBars": {"type": "number", "default": 1, "min": 0.5, "max": 3},
    "gateBacking": {"type": "number", "default": 0, "min": 0, "max": 2},
    "doorPanels": {"type": "integer", "default": 0, "min": 0, "max": 4},
    "signs": {"type": "boolean", "default": true},
    "plinth": {"type": "number", "default": 0, "min": 0, "max": 2, "unit": "m"},
    "dado": {"type": "number", "default": 0, "min": 0, "max": 2, "unit": "m"},
    "awningLower": {"type": "number", "default": 0, "min": 0, "max": 1.2, "unit": "m"},
    "shutterColor": {"type": "color", "default": "#5a6f68"},
    "doorColor": {"type": "color", "default": "#2f4f43"},
    "door": {"type": "choice", "default": "auto", "choices": ["auto", "single", "double", "glazed", "steel"]},
    "transom": {"type": "choice", "default": "auto", "choices": ["auto", "glazed", "mesh", "none"]},
    "fitted": {"type": "boolean", "default": false},
    "shutterHead": {"type": "number", "default": 0.22, "min": 0.1, "max": 1, "unit": "m"},
    "shutterHeadRust": {"type": "number", "default": 0, "min": 0, "max": 1},
    "fascia": {"type": "boolean", "default": true},
    "meters": {"type": "boolean", "default": true},
    "meterPlan": {"type": "grid", "default": []},
    "arris": {"type": "number", "default": 0, "min": 0, "max": 0.05, "unit": "m"},
    "arrisStart": {"type": "number", "default": 0, "min": 0, "max": 2},
    "arrisEnd": {"type": "number", "default": 0, "min": 0, "max": 2}
  },
  "derived": {
    "spans": "count(shopSpans)",
    "shops": "select(spans > 0, spans, max(1, floor((width - edge * 2) / shopWidth)))",
    "pitch": "(width - edge * 2) / shops"
  },
  "parts": [
    {
      "id": "wall",
      "generator": {
        "kind": "panel",
        "width": {"parameter": "width"},
        "height": {"parameter": "height"},
        "thickness": {"parameter": "thickness"},
        "patternAnchor": ["-u0", 0],
        "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"},
        "openings": [
          {"id": "shop", "repeat": {"name": "i", "count": {"derived": "shops"}}, "jambs": {"parameter": "arris"},
           "width": "(select(spans > 0, cell(shopSpans, i, 1), edge + i * pitch + pitch - 0.15)) - (select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))", "height": "select(fitted * ((floor(select(cell(shopPlan, i) == 0, random(seed, i, 5) * 8, 7 + cell(shopPlan, i))) == 4) + (floor(select(cell(shopPlan, i) == 0, random(seed, i, 5) * 8, 7 + cell(shopPlan, i))) == 11)), 2.5, height - 0.5)",
           "u": {"from": "start", "offset": "select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)"}, "v": {"from": "start", "offset": 0.02}}
        ]
      },
      "slots": {"front": "wall", "edge": "wall", "reveal": "wall"},
      "zones": [
        {"name": "runoff-top", "below": "top", "face": "front", "length": {"parameter": "height"}, "u0": {"parameter": "u0"}}
      ]
    },
    {
      "id": "shop",
      "repeat": [{"name": "i", "count": {"derived": "shops"}}],
      "generator": {"kind": "item", "entry": "kowloon-shopfront.item.json",
        "parameters": {"width": {"expr": "(select(spans > 0, cell(shopSpans, i, 1), edge + i * pitch + pitch - 0.15)) - (select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))"}, "height": {"expr": "height - 0.05"},
                       "kind": {"choose": ["open", "shutter", "gate", "shop", "door", "open", "shop", "gate", "shop", "shutter", "gate", "door", "service", "open"],
                                "by": "select(cell(shopPlan, i) == 0, random(seed, i, 5) * 8, 7 + cell(shopPlan, i))"},
                       "trade": {"choose": ["provisions", "grocer", "greengrocer", "hardware", "herbalist"], "by": "select(cell(tradePlan, i) == 0, random(seed, i, 9) * 5, cell(tradePlan, i) - 1)"},
                       "depth": {"expr": "select((select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) < cornerStart, min(shopDepth, cornerDepth), shopDepth)"}, "gateColor": {"parameter": "gateColor"},
                       "gateBars": {"parameter": "gateBars"}, "gateBacking": {"parameter": "gateBacking"}, "doorPanels": {"parameter": "doorPanels"},
                       "signs": {"parameter": "signs"}, "awningLower": {"parameter": "awningLower"}, "shutterColor": {"parameter": "shutterColor"}, "doorColor": {"parameter": "doorColor"},
                       "door": {"parameter": "door"}, "transom": {"parameter": "transom"}, "shutterHead": {"parameter": "shutterHead"}, "shutterHeadRust": {"parameter": "shutterHeadRust"},
                       "opening": {"expr": "select(fitted, 0.02 + select((floor(select(cell(shopPlan, i) == 0, random(seed, i, 5) * 8, 7 + cell(shopPlan, i))) == 4) + (floor(select(cell(shopPlan, i) == 0, random(seed, i, 5) * 8, 7 + cell(shopPlan, i))) == 11), 2.5, height - 0.5), 0)"},
                       "awning": {"choose": [false, true], "by": "select(cell(awningPlan, i) == 0, random(seed, i, 6) < awningChance, cell(awningPlan, i) >= 2)"},
                       "awningKind": {"choose": ["awning", "awning", "awning", "tarp", "striped", "awning"], "by": "select(cell(awningPlan, i) == 0, 3 + random(seed, i, 8) * 3, cell(awningPlan, i))"},
                       "awningOverhang": {"expr": "select(floor(select(cell(awningPlan, i) == 0, 3 + random(seed, i, 8) * 3, cell(awningPlan, i))) == 5, -0.15, select(cell(awningPlan, i) == 2, -0.15, 0.1))"},
                       "clutter": {"choose": ["auto", "none", "crates", "cartons", "mixed", "crates", "cartons", "mixed", "crates", "cartons", "mixed"], "by": "cell(clutterPlan, i)"},
                       "clutterSide": {"choose": ["auto", "auto", "auto", "auto", "auto", "left", "left", "left", "right", "right", "right"], "by": "cell(clutterPlan, i)"},
                       "clutterLeft": {"expr": "max(0, (select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) - 0.02)"},
                       "clutterRight": {"expr": "max(0, width - (select(spans > 0, cell(shopSpans, i, 1), edge + i * pitch + pitch - 0.15)) - 0.02)"},
                       "awningColor": {"choose": ["#6b6f5c", "#778778", "#6b6f5c", "#8a8f7a", "#9a5a4a"], "by": "select(floor(select(cell(awningPlan, i) == 0, 3 + random(seed, i, 8) * 3, cell(awningPlan, i))) == 4, 4, random(seed, i, 7) * 4)"},
                       "awningSag": {"expr": "select(cell(awningSagPlan, i) > 0, min(0.8, cell(awningSagPlan, i)), 0.28)"},
                       "awningStripes": {"expr": "clamp(round(cell(awningStripePlan, i)), 0, 60)"},
                       "lamp": {"choose": [false, true], "by": "i + 1 < shops"},
                       "seed": {"expr": "seed * 1000 + i"}}},
      "placement": {"position": ["((select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) + (select(spans > 0, cell(shopSpans, i, 1), edge + i * pitch + pitch - 0.15))) / 2", 0, 0]}
    },
    {
      "id": "plinth",
      "repeat": [{"name": "i", "count": "shops + 1"}],
      "when": "(plinth > 0) * ((select(i == shops, width, select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))) - (select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))) > 0.05)",
      "generator": {"kind": "box", "size": ["(select(i == shops, width, select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))) - (select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15)))", 0.018, {"parameter": "plinth"}], "bevel": "min(0.008, plinth / 4)", "bevelAxis": "x"},
      "placement": {"position": ["select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))", -0.018, 0]},
      "slots": {"side": "plinth", "top": "plinth", "bottom": "plinth"}
    },
    {
      "id": "dado",
      "repeat": [{"name": "i", "count": "shops + 1"}],
      "when": "(dado > 0) * ((select(i == shops, width, select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))) - (select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))) > 0.05)",
      "generator": {"kind": "box", "size": ["(select(i == shops, width, select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15))) - (select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15)))", 0.015, {"parameter": "dado"}]},
      "placement": {"position": ["select(i == 0, 0, select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))", -0.015, 0]},
      "slots": {"side": "tile"}
    },
    {
      "id": "meters",
      "repeat": [{"name": "i", "count": {"derived": "shops"}}],
      "when": "meters * (count(meterPlan) == 0) * (i > 0) * (random(seed, i, 12) < 0.6) * ((select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) - (select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15)) >= 0.34)",
      "generator": {"kind": "native", "name": "kowloon/meter-bank",
        "parameters": {"count": {"expr": "clamp(floor(((select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) - (select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))) / 0.33), 1, 1 + floor(random(seed, i, 13) * 3))"},
                       "seed": {"expr": "seed * 1000 + 500 + i"}}},
      "placement": {"position": ["((select(spans > 0, cell(shopSpans, i, 0), edge + i * pitch + 0.15)) + (select(spans > 0, cell(shopSpans, i - 1, 1), edge + i * pitch - 0.15))) / 2", 0, 1.47]}
    },
    {
      "id": "meterAt",
      "repeat": [{"name": "k", "count": "count(meterPlan)"}],
      "generator": {"kind": "native", "name": "kowloon/meter-bank",
        "parameters": {"count": {"expr": "select(count(meterPlan, k) > 2, clamp(round(cell(meterPlan, k, 2)), 1, 16), 1)"}, "seed": {"expr": "seed * 1000 + 700 + k"}}},
      "placement": {"position": ["cell(meterPlan, k, 0)", 0, "select(count(meterPlan, k) > 1, cell(meterPlan, k, 1), 1.47)"]}
    },
    {
      "id": "fascia",
      "when": "fascia",
      "generator": {"kind": "box", "size": [{"parameter": "width"}, 0.12, 0.22], "bevel": 0.02, "bevelSegments": 2, "bevelAxis": "x"},
      "placement": {"position": [0, -0.12, "height - 0.22"]},
      "slots": {"side": "trim", "top": "trim", "bottom": "trim"}
    }
  ],
  "features": [
    {"name": "pavement", "part": "wall", "points": [[0, 0, 0], [{"parameter": "width"}, 0, 0]]},
    {"name": "eave", "part": "wall", "points": [[0, 0, {"parameter": "height"}], [{"parameter": "width"}, 0, {"parameter": "height"}]]},
    {"name": "peel", "part": "wall", "repeat": {"name": "k", "count": "max(1, floor(width / 2.4))"}, "when": "(random(seed, 0, k, 79) < 0.5) * ((k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 < width - 0.3) * ((k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 > -0.01)",
     "points": [["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72))"], ["min(width - 0.04, (k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.6 + 0.8 * random(seed, 0, k, 71))",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72))"], ["min(width - 0.04, (k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.6 + 0.8 * random(seed, 0, k, 71))",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.35 + 0.45 * random(seed, 0, k, 72)"], ["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.35 + 0.45 * random(seed, 0, k, 72)"], ["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72))"]]},
    {"name": "peel-inner", "part": "wall", "repeat": {"name": "k", "count": "max(1, floor(width / 2.4))"}, "when": "(random(seed, 0, k, 79) < 0.5) * ((k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 < width - 0.3) * ((k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 > -0.01)",
     "points": [["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.05",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.05"], ["min(width - 0.04, (k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.6 + 0.8 * random(seed, 0, k, 71)) - 0.05",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.05"], ["min(width - 0.04, (k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.6 + 0.8 * random(seed, 0, k, 71)) - 0.05",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.35 + 0.45 * random(seed, 0, k, 72) - 0.05"], ["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.05",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.35 + 0.45 * random(seed, 0, k, 72) - 0.05"], ["(k + 0.1 + 0.55 * random(seed, 0, k, 70)) * 2.4 + 0.05",0,"height - 0.25 - (0.35 + 0.45 * random(seed, 0, k, 72)) + 0.05"]]},
    {"name": "peel", "part": "wall", "repeat": {"name": "k", "count": "max(1, floor(width / 2))"}, "when": "(random(seed, 0, k, 89) < 0.65) * ((k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 < width - 0.3) * ((k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 > -0.01)",
     "points": [["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2",0,"1.0 + 0.05 * random(seed, 0, k, 82)"], ["min(width - 0.04, (k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.7 + 1.0 * random(seed, 0, k, 81))",0,"1.0 + 0.05 * random(seed, 0, k, 82)"], ["min(width - 0.04, (k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.7 + 1.0 * random(seed, 0, k, 81))",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.3 + 0.4 * random(seed, 0, k, 83)"], ["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.3 + 0.4 * random(seed, 0, k, 83)"], ["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2",0,"1.0 + 0.05 * random(seed, 0, k, 82)"]]},
    {"name": "peel-inner", "part": "wall", "repeat": {"name": "k", "count": "max(1, floor(width / 2))"}, "when": "(random(seed, 0, k, 89) < 0.65) * ((k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 < width - 0.3) * ((k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 > -0.01)",
     "points": [["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.05",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.05"], ["min(width - 0.04, (k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.7 + 1.0 * random(seed, 0, k, 81)) - 0.05",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.05"], ["min(width - 0.04, (k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.7 + 1.0 * random(seed, 0, k, 81)) - 0.05",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.3 + 0.4 * random(seed, 0, k, 83) - 0.05"], ["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.05",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.3 + 0.4 * random(seed, 0, k, 83) - 0.05"], ["(k + 0.1 + 0.5 * random(seed, 0, k, 80)) * 2 + 0.05",0,"1.0 + 0.05 * random(seed, 0, k, 82) + 0.05"]]},
    {"name": "peel", "part": "wall", "repeat": {"name": "k", "count": 2}, "when": "(random(seed, 0, k, 99) < 0.6) * (select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) < width - 0.3) * (select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) > -0.01)",
     "points": [["select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91))",0,"1.1 + (height - 2.2) * random(seed, 0, k, 92)"], ["min(width - 0.04, select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) + 0.38 + 0.4 * random(seed, 0, k, 91))",0,"1.1 + (height - 2.2) * random(seed, 0, k, 92)"], ["min(width - 0.04, select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) + 0.38 + 0.4 * random(seed, 0, k, 91))",0,"1.1 + (height - 2.2) * random(seed, 0, k, 92) + 0.5 + 0.6 * random(seed, 0, k, 93)"], ["select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91))",0,"1.1 + (height - 2.2) * random(seed, 0, k, 92) + 0.5 + 0.6 * random(seed, 0, k, 93)"], ["select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91))",0,"1.1 + (height - 2.2) * random(seed, 0, k, 92)"]]},
    {"name": "peel-inner", "part": "wall", "repeat": {"name": "k", "count": 2}, "when": "(random(seed, 0, k, 99) < 0.6) * (select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) < width - 0.3) * (select(k == 0, 0.02, width - 0.4 - 0.4 * random(seed, 0, k, 91)) > -0.01)",
