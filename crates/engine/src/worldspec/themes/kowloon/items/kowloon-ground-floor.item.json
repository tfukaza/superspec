{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-ground-floor",
  "parameters": {
    "paint": {"type": "color", "default": "#e6d6b0"},
    "peeling": {"type": "number", "default": 0.18, "min": 0, "max": 1},
    "width": {"type": "number", "default": 9, "min": 2, "max": 40, "unit": "m"},
    "height": {"type": "number", "default": 3.35, "min": 2.6, "max": 6, "unit": "m"},
    "thickness": {"type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "unit": "m"},
    "edge": {"type": "number", "default": 0.35, "min": 0.1, "max": 3, "unit": "m"},
    "shopWidth": {"type": "number", "default": 3.0, "min": 1.6, "max": 12, "unit": "m"},
    "seed": {"type": "integer", "default": 1, "min": 0, "max": 100000},
    "awningChance": {"type": "number", "default": 0.4, "min": 0, "max": 1}
  },
  "derived": {
    "shops": "max(1, floor((width - edge * 2) / shopWidth))",
    "pitch": "(width - edge * 2) / shops"
  },
  "parts": [
    {
      "id": "wall",
      "generator": {
        "kind": "panel",
        "width": {"parameter": "width"},
        "height": {"parameter": "height"},
        "thickness": {"parameter": "thickness"},
        "openings": [
          {"id": "shop", "repeat": {"name": "i", "count": {"derived": "shops"}},
           "width": "pitch - 0.3", "height": "height - 0.5",
           "u": {"from": "start", "offset": "edge + i * pitch + 0.15"}, "v": {"from": "start", "offset": 0.02}}
        ]
      },
      "slots": {"front": "wall", "back": "wall", "edge": "wall", "reveal": "wall"}
    },
    {
      "id": "shop",
      "repeat": [{"name": "i", "count": {"derived": "shops"}}],
      "generator": {"kind": "item", "entry": "kowloon-shopfront.item.json",
        "parameters": {"width": {"expr": "pitch - 0.3"}, "height": {"expr": "height - 0.05"},
                       "kind": {"choose": ["shop", "shutter", "gate", "shop", "door", "shutter"], "by": "random(seed, i, 5) * 6"},
                       "awning": {"choose": [false, true], "by": "random(seed, i, 6) < awningChance"},
                       "awningColor": {"choose": ["#3f7f5f", "#9a3b2e", "#2f5f8a", "#c79a3a"], "by": "random(seed, i, 7) * 4"},
                       "lamp": {"choose": [false, true], "by": "i + 1 < shops"},
                       "seed": {"expr": "seed * 1000 + i"}}},
      "placement": {"position": ["edge + i * pitch + pitch / 2", 0, 0]}
    },
    {
      "id": "fascia",
      "generator": {"kind": "box", "size": [{"parameter": "width"}, 0.12, 0.22]},
      "placement": {"position": [0, -0.12, "height - 0.22"]},
      "slots": {"side": "trim", "top": "trim", "bottom": "trim"}
    }
  ],
  "layers": {
    "wall": [
      {"entry": "kowloon-paint-coat.material.ts", "parameters": {"color": {"parameter": "paint"}, "peeling": {"parameter": "peeling"}}, "seed": 1},
      {"entry": "kowloon-ground-stain.material.ts", "parameters": {"dampness": 0.6}, "seed": 2},
      {"entry": "kowloon-moss.material.ts", "parameters": {"dampness": 0.5}, "seed": 4},
      {"entry": "kowloon-top-grime.material.ts", "parameters": {"amount": 0.5}, "seed": 6, "follow": {"top": "drip"}}
    ]
  }
}
