      "zones": [
        {"name": "runoff-coping", "below": "top", "face": "front", "length": {"parameter": "height"}, "u0": {"parameter": "u0"}}
      ]
    },
    {
      "id": "coping",
      "generator": {"kind": "box", "size": ["width + select(copingFlush * (miterStart > 0), 0.05 * miterStart, 0.04) + select(copingFlush * (miterEnd > 0), 0.05 * miterEnd, 0.04)", "thickness + 0.1", 0.08],
        "bevel": {"parameter": "copingBevel"}, "bevelSegments": 2, "bevelAxis": "x"},
      "placement": {"position": ["0 - select(copingFlush * (miterStart > 0), 0.05 * miterStart, 0.04)", -0.05, {"parameter": "height"}]},
      "slots": {"side": "trim", "top": "trim", "bottom": "trim"}
    },
    {
      "id": "ledge",
      "when": "ledge",
      "generator": {"kind": "native", "name": "kowloon/cornice",
        "parameters": {"length": {"parameter": "width"}, "color": "#ffffff", "miterStart": {"parameter": "miterStart"}, "miterEnd": {"parameter": "miterEnd"}}},
      "slots": {"concrete": "trim"}
    },
    {
      "id": "outlet",
      "when": "outlet",
      "generator": {"kind": "native", "name": "kowloon/roof-outlet", "parameters": {}},
      "placement": {"position": [{"parameter": "outletX"}, 0, 0.1]}
    }
  ],
  "features": [
    {"name": "peel", "part": "parapet", "repeat": {"name": "k", "count": "max(1, floor(width / 2.4))"}, "when": "(random(width, u0, k, 19) < 0.3) * ((k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 < width - 0.3)",
     "points": [["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0"],["min(width - 0.04, (k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.4 + 0.6 * random(width, u0, k, 11)) - 0",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0"],["min(width - 0.04, (k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.4 + 0.6 * random(width, u0, k, 11)) - 0",0,"min(height - 0.04, 0.04 + 0.2 * random(width, u0, k, 12) + height * (0.2 + 0.25 * random(width, u0, k, 13))) - 0"],["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0",0,"min(height - 0.04, 0.04 + 0.2 * random(width, u0, k, 12) + height * (0.2 + 0.25 * random(width, u0, k, 13))) - 0"],["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0"]]},
    {"name": "peel-inner", "part": "parapet", "repeat": {"name": "k", "count": "max(1, floor(width / 2.4))"}, "when": "(random(width, u0, k, 19) < 0.3) * ((k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 < width - 0.3)",
     "points": [["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.05",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0.05"],["min(width - 0.04, (k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.4 + 0.6 * random(width, u0, k, 11)) - 0.05",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0.05"],["min(width - 0.04, (k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.4 + 0.6 * random(width, u0, k, 11)) - 0.05",0,"min(height - 0.04, 0.04 + 0.2 * random(width, u0, k, 12) + height * (0.2 + 0.25 * random(width, u0, k, 13))) - 0.05"],["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.05",0,"min(height - 0.04, 0.04 + 0.2 * random(width, u0, k, 12) + height * (0.2 + 0.25 * random(width, u0, k, 13))) - 0.05"],["(k + 0.1 + 0.5 * random(width, u0, k, 10)) * 2.4 + 0.05",0,"0.04 + 0.2 * random(width, u0, k, 12) + 0.05"]]},
    {"name": "peel", "part": "parapet", "repeat": {"name": "k", "count": 2}, "when": "(random(width, u0, k, 29) < 0.3) * (select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) < width - 0.3)",
     "points": [["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0",0,"0.02 + 0"],["min(width - 0.04, select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.3 + 0.25 * random(width, u0, k, 21)) - 0",0,"0.02 + 0"],["min(width - 0.04, select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.3 + 0.25 * random(width, u0, k, 21)) - 0",0,"min(height - 0.04, 0.02 + height * (0.25 + 0.3 * random(width, u0, k, 23))) - 0"],["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0",0,"min(height - 0.04, 0.02 + height * (0.25 + 0.3 * random(width, u0, k, 23))) - 0"],["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0",0,"0.02 + 0"]]},
    {"name": "peel-inner", "part": "parapet", "repeat": {"name": "k", "count": 2}, "when": "(random(width, u0, k, 29) < 0.3) * (select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) < width - 0.3)",
     "points": [["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.05",0,"0.02 + 0.05"],["min(width - 0.04, select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.3 + 0.25 * random(width, u0, k, 21)) - 0.05",0,"0.02 + 0.05"],["min(width - 0.04, select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.3 + 0.25 * random(width, u0, k, 21)) - 0.05",0,"min(height - 0.04, 0.02 + height * (0.25 + 0.3 * random(width, u0, k, 23))) - 0.05"],["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.05",0,"min(height - 0.04, 0.02 + height * (0.25 + 0.3 * random(width, u0, k, 23))) - 0.05"],["select(k == 0, 0.02, width - 0.6 - 0.4 * random(width, u0, k, 21)) + 0.05",0,"0.02 + 0.05"]]},
    {"name": "drip", "part": "outlet", "points": [["outletX - 0.14", 0, 0.1], ["outletX + 0.14", 0, 0.1]], "when": "outlet", "zone": {"length": 1.5}},
    {"name": "coping", "part": "parapet", "points": [[0, 0, {"parameter": "height"}], [{"parameter": "width"}, 0, {"parameter": "height"}]]}
  ],
  "layers": {
    "wall": [
      {"entry": "kowloon-paint-coat.material.ts", "parameters": {"color": {"parameter": "paint"}, "peeling": 0, "patches": 0, "patchScale": 1.3, "unevenness": 0.15, "arrisWear": 0.7, "peelShare": 0.85, "bareCover": 0.85}, "seed": 1, "follow": {"peel": "peel", "peelInner": "peel-inner"}},
      {"entry": "kowloon-edge-ink.material.ts", "parameters": {"inkColor": [0.075, 0.066, 0.055], "inkStrength": 1, "inkWidth": 0.1, "highlight": 0.5, "highlightWidth": 0.022, "halo": 0.32, "haloWidth": 0.14, "fixtureHalo": 0.9, "fixtureWidth": 0.4}, "seed": 9, "follow": {"opening": "opening-edge", "sill": "sill", "fixture": "fixture", "fixing": "fixing"}},
      {"entry": "kowloon-grime-streaks.material.ts", "parameters": {"strength": 0.95, "color": [0.33, 0.3, 0.25], "streakLength": 2.2, "period": 6.5, "variety": 0.6}, "seed": 3, "follow": {"zone": ["drip","ledge","runoff-coping","runoff-sill","runoff-top"]}},
      {"entry": "kowloon-grime-streaks.material.ts", "parameters": {"strength": 1.1, "color": [0.29, 0.26, 0.22], "streakLength": 1.4, "shift": 1.7, "period": 4.2, "variety": 0.4, "lip": 0.6}, "seed": 5, "follow": {"zone": ["runoff-coping", "runoff-sill", "runoff-top"]}}
    ]
  }
}
