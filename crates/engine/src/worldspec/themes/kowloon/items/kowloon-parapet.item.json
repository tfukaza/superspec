{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-parapet",
  "parameters": {
    "z0": {"type": "number", "default": 0, "min": 0, "max": 200, "unit": "m"},
    "u0": {"type": "number", "default": 0, "min": -1000, "max": 1000, "unit": "m"},
    "paint": {"type": "color", "default": "#c0b49e"},
    "peeling": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "width": {"type": "number", "default": 9, "min": 0.1, "max": 40, "unit": "m"},
    "copingFlush": {"type": "boolean", "default": false},
    "copingBevel": {"type": "number", "default": 0.02, "min": 0, "max": 0.035, "unit": "m"},
    "thickness": {"type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "unit": "m"},
    "height": {"type": "number", "default": 0.95, "min": 0.3, "max": 2, "unit": "m"},
    "outlet": {"type": "boolean", "default": false},
    "outletX": {"type": "number", "default": 0.45, "min": 0, "max": 40, "unit": "m"},
    "ledge": {"type": "boolean", "default": false},
    "miterStart": {"type": "number", "default": 0, "min": 0, "max": 4},
    "miterEnd": {"type": "number", "default": 0, "min": 0, "max": 4},
    "arris": {"type": "number", "default": 0, "min": 0, "max": 0.05, "unit": "m"},
    "arrisStart": {"type": "number", "default": 0, "min": 0, "max": 2},
    "arrisEnd": {"type": "number", "default": 0, "min": 0, "max": 2}
  },
  "parts": [
    {
      "id": "parapet",
      "generator": {"kind": "panel", "width": {"parameter": "width"}, "height": {"parameter": "height"}, "thickness": {"parameter": "thickness"},
        "patternAnchor": ["-u0", "-z0"],
        "arris": {"parameter": "arris"}, "arrisStart": {"parameter": "arrisStart"}, "arrisEnd": {"parameter": "arrisEnd"}},
      "slots": {"front": "wall", "back": "wall", "edge": "wall"}
    },
    {
      "id": "coping",
      "generator": {"kind": "box", "size": ["width + select(copingFlush * (miterStart > 0), 0.05 * miterStart, 0.04) + select(copingFlush * (miterEnd > 0), 0.05 * miterEnd, 0.04)", "thickness + 0.1", 0.08],
        "bevel": {"parameter": "copingBevel"}, "bevelSegments": 2, "bevelAxis": "x"},
      "placement": {"position": ["0 - select(copingFlush * (miterStart > 0), 0.05 * miterStart, 0.04)", -0.05, {"parameter": "height"}]},
      "slots": {"side": "trim", "top": "trim", "bottom": "trim"}
    },
    {
      "id": "ledge",
      "when": "ledge",
      "generator": {"kind": "native", "name": "kowloon/cornice",
        "parameters": {"length": {"parameter": "width"}, "color": "#ffffff", "miterStart": {"parameter": "miterStart"}, "miterEnd": {"parameter": "miterEnd"}}},
      "slots": {"concrete": "trim"}
    },
    {
      "id": "outlet",
      "when": "outlet",
      "generator": {"kind": "native", "name": "kowloon/roof-outlet", "parameters": {}},
      "placement": {"position": [{"parameter": "outletX"}, 0, 0.1]}
    }
  ],
  "features": [
    {"name": "drip", "part": "outlet", "points": [["outletX - 0.14", 0, 0.1], ["outletX + 0.14", 0, 0.1]], "when": "outlet"},
    {"name": "drip-above", "part": "outlet", "points": [["outletX - 0.14", 0, 0.4], ["outletX + 0.14", 0, 0.4]], "when": "outlet"},
    {"name": "coping", "part": "parapet", "points": [[0, 0, {"parameter": "height"}], [{"parameter": "width"}, 0, {"parameter": "height"}]]},
    {"name": "coping-above", "part": "parapet", "points": [[0, 0, "height + 0.3"], [{"parameter": "width"}, 0, "height + 0.3"]]}
  ],
  "layers": {
    "wall": [
      {"entry": "kowloon-paint-coat.material.ts", "parameters": {"color": {"parameter": "paint"}, "peeling": 0, "patches": 0, "patchScale": 1.3, "unevenness": 0.15}, "seed": 1},
      {"entry": "kowloon-edge-ink.material.ts", "parameters": {"inkColor": [0.075, 0.066, 0.055], "inkStrength": 1, "inkWidth": 0.1, "highlight": 0.5, "highlightWidth": 0.012}, "seed": 9},
      {"entry": "kowloon-grime-streaks.material.ts", "parameters": {"strength": 2, "color": [0.24, 0.215, 0.18], "streakLength": 2.2, "period": 3.6}, "seed": 3, "follow": {"source": ["drip", "eave", "ledge", "sill"], "guard": ["drip-above", "eave-above", "ledge-above", "sill-above"]}},
      {"entry": "kowloon-grime-streaks.material.ts", "parameters": {"strength": 2, "color": [0.2, 0.18, 0.15], "streakLength": 1.5, "shift": 1.7, "period": 2.3}, "seed": 5, "follow": {"source": "coping", "guard": "coping-above"}}
    ]
  }
}
