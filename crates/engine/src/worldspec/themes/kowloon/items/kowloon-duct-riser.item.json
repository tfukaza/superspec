{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-duct-riser",
  "parameters": {
    "floors": {"type": "integer", "default": 4, "min": 1, "max": 12},
    "storyHeight": {"type": "number", "default": 3.0, "min": 2.4, "max": 5, "unit": "m"},
    "height": {"type": "number", "default": 12, "min": 3, "max": 60, "unit": "m"},
    "firstFloor": {"type": "number", "default": 0, "min": 0, "max": 10, "unit": "m"},
    "width": {"type": "number", "default": 0.4, "min": 0.2, "max": 0.8, "unit": "m"},
    "depth": {"type": "number", "default": 0.3, "min": 0.15, "max": 0.6, "unit": "m"},
    "standoff": {"type": "number", "default": 0.06, "min": 0.05, "max": 0.6, "unit": "m"},
    "base": {"type": "number", "default": 0.9, "min": 0.3, "max": 12, "unit": "m"},
    "branches": {"type": "boolean", "default": true}
  },
  "derived": {
    "top": "height - 0.35",
    "half": "width / 2",
    "axis": "standoff + depth / 2",
    "avail": "top - base - 1.2",
    "brackets": "max(1, ceil(avail / 1.3 - 0.000000001))",
    "pitch": "avail / brackets",
    "b0": "base + 1.05 - firstFloor"
  },
  "parts": [
    {
      "id": "riser",
      "generator": {
        "kind": "route",
        "section": {"kind": "rect", "width": {"parameter": "width"}, "height": {"parameter": "depth"}},
        "wallThickness": 0.004,
        "points": [[0, "-axis", {"parameter": "base"}], [0, "-axis", {"derived": "top"}]],
        "up": [0, 1, 0],
        "capped": true,
        "fittings": [
          {"kind": "flange", "id": "seam", "at": {"every": 1.3, "inset": 0.6}, "overhang": 0.025, "thickness": 0.032}
        ]
      },
      "slots": {"body": "galvanized", "fitting": "galvanized", "bolt": "steel", "end": "galvanized"}
    },
    {
      "id": "elbow",
      "generator": {
        "kind": "route",
        "from": {"attachment": "riser/end"},
        "section": {"kind": "rect", "width": {"parameter": "width"}, "height": {"parameter": "depth"}},
        "wallThickness": 0.004,
        "points": [[0, 0, -0.05], [0, 0, 0.35], [0, "axis + 0.12", 0.35]],
        "bendRadius": 0.3,
        "up": [0, 1, 0],
        "capped": false,
        "fittings": [{"kind": "flange", "id": "joint", "at": {"from": "start", "offset": 0.05}, "overhang": 0.025, "thickness": 0.032}]
      },
      "slots": {"body": "galvanized", "fitting": "galvanized", "end": "galvanized"}
    },
    {
      "id": "hood",
      "generator": {"kind": "box", "size": ["width + 0.1", "depth + 0.1", 0.36]},
      "placement": {"position": ["-(width + 0.1) / 2", "-axis - (depth + 0.1) / 2", "base - 0.36"]},
      "slots": {"side": "galvanized", "top": "galvanized", "bottom": "opening"}
    },
    {
      "id": "bracket",
      "repeat": [{"name": "k", "count": {"derived": "brackets"}}],
      "generator": {"kind": "item", "entry": "kowloon-duct-bracket.item.json",
        "parameters": {"width": {"parameter": "width"}, "depth": {"parameter": "depth"}, "standoff": {"parameter": "standoff"}}},
      "placement": {"position": [0, 0, "base + 0.6 + pitch * (k + 0.5) + select(abs(((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight))) < 0.2, select(((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight)) < 0, -0.2, 0.2) - ((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight)), select(abs(((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight)) - 0.45) < 0.1, select(((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight)) < 0.45, 0.35, 0.55) - ((b0 + pitch * (k + 0.5)) - storyHeight * round((b0 + pitch * (k + 0.5)) / storyHeight)), 0))"]}
    },
    {
      "id": "branch",
      "repeat": [{"name": "j", "count": {"parameter": "floors"}}],
      "when": "branches",
      "generator": {
        "kind": "route",
        "section": {"kind": "rect", "width": "width * 0.6", "height": "depth * 0.6"},
        "points": [["width * 0.2", "-axis", "firstFloor + j * storyHeight + storyHeight - 0.45"], ["width * 0.2", 0.05, "firstFloor + j * storyHeight + storyHeight - 0.45"]],
        "up": [0, 0, 1],
        "capped": false,
        "fittings": [{"kind": "flange", "id": "collar", "at": {"from": "end", "offset": 0.061}, "overhang": 0.04, "thickness": 0.022, "bolts": 4}]
      },
      "slots": {"body": "galvanized", "fitting": "galvanized", "bolt": "steel", "end": "galvanized"}
    }
  ],
  "features": [
    {"name": "fixture", "part": "riser", "reach": "item", "within": 1, "points": [[0, 0, "base - 0.36"], [0, 0, "top + 0.35"]]},
    {"name": "fixing", "part": "riser", "reach": "item", "within": 1, "repeat": {"name": "j", "count": {"parameter": "floors"}}, "when": "branches", "points": [["width * 0.2 - width * 0.3 - 0.04", 0, "firstFloor + j * storyHeight + storyHeight - 0.45"], ["width * 0.2 + width * 0.3 + 0.04", 0, "firstFloor + j * storyHeight + storyHeight - 0.45"]]},
    {"name": "rust", "part": "riser", "reach": "item", "within": 1, "repeat": {"name": "j", "count": {"parameter": "floors"}}, "when": "branches", "points": [["width * 0.2 - 0.1", 0, "firstFloor + j * storyHeight + storyHeight - 0.45 - depth * 0.3 - 0.04"], ["width * 0.2 + 0.1", 0, "firstFloor + j * storyHeight + storyHeight - 0.45 - depth * 0.3 - 0.04"]], "zone": {"length": 0.7}},
    {"name": "drip", "part": "riser", "reach": "item", "within": 1, "repeat": {"name": "j", "count": {"parameter": "floors"}}, "when": "branches", "points": [["width * 0.2 - width * 0.3 - 0.04", 0, "firstFloor + j * storyHeight + storyHeight - 0.45 - depth * 0.3 - 0.04"], ["width * 0.2 + width * 0.3 + 0.04", 0, "firstFloor + j * storyHeight + storyHeight - 0.45 - depth * 0.3 - 0.04"]], "zone": {"length": 1}}
  ],
  "slots": {},
  "attachments": [
    {"name": "foot", "position": [0, "-axis", "base - 0.36"], "direction": [0, 0, -1]}
  ],
  "layers": {
    "galvanized": [
      {"entry": "kowloon-underside-grime.material.ts", "parameters": {"facing": 0.3}, "seed": 41, "follow": {"fixture": "fixture"}}
    ]
  }
}
