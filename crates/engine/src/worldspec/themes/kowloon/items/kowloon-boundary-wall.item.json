{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-boundary-wall",
  "parameters": {
    "path": {"type": "grid", "default": [[0, 0], [4, 0], [7, 2], [7, 5]]},
    "closed": {"type": "boolean", "default": false},
    "height": {"type": "number", "default": 2.2, "min": 0.5, "max": 8, "unit": "m"},
    "thickness": {"type": "number", "default": 0.28, "min": 0.12, "max": 1, "unit": "m"},
    "paint": {"type": "color", "default": "#b7ad94"}
  },
  "derived": {
    "n": "count(path)",
    "runs": "max(0, n - 1 + closed * (n > 2))",
    "base": "min(0.4, height / 4)",
    "pier": "1.5 * (thickness + 0.08)"
  },
  "parts": [
    {
      "id": "plinth",
      "repeat": [{"name": "i", "count": "runs"}],
      "generator": {"kind": "route", "section": {"kind": "rect", "width": "thickness + 0.035", "height": "base"},
        "points": [["cell(path, i, 0)", "cell(path, i, 1)", "base / 2"], ["cell(path, (i + 1) % n, 0)", "cell(path, (i + 1) % n, 1)", "base / 2"]],
        "up": [0, 0, 1], "capped": true},
      "slots": {"body": "stone", "end": "stone"}
    },
    {
      "id": "wall",
      "repeat": [{"name": "i", "count": "runs"}],
      "generator": {"kind": "route", "section": {"kind": "rect", "width": "thickness", "height": "height - base"},
        "points": [["cell(path, i, 0)", "cell(path, i, 1)", "(height + base) / 2"], ["cell(path, (i + 1) % n, 0)", "cell(path, (i + 1) % n, 1)", "(height + base) / 2"]],
        "up": [0, 0, 1], "capped": true},
      "slots": {"body": "render", "end": "render"}
    },
    {
      "id": "coping",
      "repeat": [{"name": "i", "count": "runs"}],
      "generator": {"kind": "route", "section": {"kind": "rect", "width": "thickness + 0.08", "height": 0.09},
        "points": [["cell(path, i, 0)", "cell(path, i, 1)", "height + 0.045"], ["cell(path, (i + 1) % n, 0)", "cell(path, (i + 1) % n, 1)", "height + 0.045"]],
        "up": [0, 0, 1], "capped": true},
      "slots": {"body": "stone", "end": "stone"}
    },
    {
      "id": "pier",
      "repeat": [{"name": "i", "count": "n * (n > 1)"}],
      "generator": {"kind": "box", "size": ["pier", "pier", "height + 0.15"]},
      "placement": {"position": ["cell(path, i, 0) - pier / 2", "cell(path, i, 1) - pier / 2", 0]},
      "slots": {"side": "stone", "top": "stone", "bottom": "stone"}
    }
  ],
  "slots": {
    "render": {"entry": "kowloon-wall-render.ms", "parameters": {"tint": {"parameter": "paint"}}, "seed": 11},
    "stone": {"entry": "kowloon-wall-render.ms", "parameters": {"tint": [0.22, 0.20, 0.16]}, "seed": 12}
  },
  "collision": "mesh"
}
