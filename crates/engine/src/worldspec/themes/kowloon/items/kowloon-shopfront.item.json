{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-shopfront",
  "parameters": {
    "width": {"type": "number", "default": 3.0, "min": 1.5, "max": 20, "unit": "m"},
    "height": {"type": "number", "default": 3.35, "min": 2.4, "max": 6, "unit": "m"},
    "kind": {"type": "choice", "default": "shutter", "choices": ["shutter", "gate", "door", "shop", "service", "open"]},
    "trade": {"type": "choice", "default": "provisions", "choices": ["provisions", "grocer", "greengrocer", "hardware", "herbalist"]},
    "depth": {"type": "number", "default": 3.1, "min": 0, "max": 20, "unit": "m"},
    "stock": {"type": "boolean", "default": true},
    "clutter": {"type": "choice", "default": "none", "choices": ["none", "auto", "crates", "cartons", "mixed"]},
    "clutterSide": {"type": "choice", "default": "auto", "choices": ["auto", "left", "right"]},
    "clutterLeft": {"type": "number", "default": 0.3, "min": 0, "max": 40, "unit": "m"},
    "clutterRight": {"type": "number", "default": 0.3, "min": 0, "max": 40, "unit": "m"},
    "gateColor": {"type": "color", "default": "#647a6b"},
    "gateBars": {"type": "number", "default": 1, "min": 0.5, "max": 3},
    "gateBacking": {"type": "number", "default": 0, "min": 0, "max": 2},
    "doorPanels": {"type": "integer", "default": 0, "min": 0, "max": 4},
    "seed": {"type": "integer", "default": 0, "min": 0, "max": 100000000},
    "signs": {"type": "boolean", "default": true},
    "awning": {"type": "boolean", "default": false},
    "awningKind": {"type": "choice", "default": "awning", "choices": ["awning", "tarp", "striped"]},
    "awningColor": {"type": "color", "default": "#3f7f5f"},
    "awningOverhang": {"type": "number", "default": -0.15, "min": -1, "max": 2, "unit": "m"},
    "awningSag": {"type": "number", "default": 0.28, "min": 0, "max": 0.8, "unit": "m"},
    "awningStripes": {"type": "integer", "default": 0, "min": 0, "max": 60},
    "lamp": {"type": "boolean", "default": true},
    "awningLower": {"type": "number", "default": 0, "min": 0, "max": 1.2, "unit": "m"},
    "shutterColor": {"type": "color", "default": "#5a6f68"},
    "doorColor": {"type": "color", "default": "#2f4f43"},
    "door": {"type": "choice", "default": "auto", "choices": ["auto", "single", "double", "glazed", "steel"]},
    "transom": {"type": "choice", "default": "auto", "choices": ["auto", "glazed", "mesh", "none"]},
    "opening": {"type": "number", "default": 0, "min": 0, "max": 6, "unit": "m"},
    "shutterHead": {"type": "number", "default": 0.22, "min": 0.1, "max": 1, "unit": "m"},
    "shutterHeadRust": {"type": "number", "default": 0, "min": 0, "max": 1}
  },
  "derived": {
    "open": "(kind == 5) * (width >= 1.9) * (depth >= 2.4)",
    "cluttered": "select(clutter == 1, (kind != 5) * (kind != 2) * (width >= 2.4) * (random(seed, 23) < 0.3), clutter > 1)",
    "clutterWidth": "clamp(width * 0.6, 1.2, 2.2)",
    "clutterOnRight": "select(clutterSide == 0, random(seed, 22) < 0.5, clutterSide == 2)",
    "awningWidth": "width + awningOverhang * 2",
    "awningZ": "height - 0.62 - awningLower",
    "awningBands": "select(awningStripes > 0, awningStripes * 2, 2 * max(2, round(awningWidth / 0.36)))"
  },
  "parts": [
    {
      "id": "bay",
      "when": "1 - open",
      "generator": {"kind": "native", "name": "kowloon/ground-bay",
        "parameters": {"kind": {"choose": ["shutter", "gate", "door", "shop", "service", "shutter"], "by": "kind"}, "width": {"parameter": "width"}, "height": {"parameter": "height"},
                       "seed": {"parameter": "seed"}, "signs": false, "shutter": {"parameter": "shutterColor"}, "frame": {"parameter": "doorColor"}, "gate": {"parameter": "gateColor"},
                       "gateBars": {"parameter": "gateBars"}, "gateBacking": {"parameter": "gateBacking"}, "panels": {"parameter": "doorPanels"},
                       "door": {"parameter": "door"}, "transom": {"parameter": "transom"}, "opening": {"parameter": "opening"},
                       "head": {"parameter": "shutterHead"}, "headRust": {"parameter": "shutterHeadRust"}}}
    },
    {
      "id": "backing",
      "when": "1 - open",
      "generator": {"kind": "box", "size": ["width + 0.3", 0.02, "height - 0.4"]},
      "placement": {"position": ["-(width + 0.3) / 2", 0.3, 0]},
      "slots": {"side": "pane"}
    },
    {
      "id": "room",
      "when": "open",
      "generator": {"kind": "native", "name": "kowloon/shop-room",
        "parameters": {"trade": {"parameter": "trade"}, "width": {"parameter": "width"}, "height": {"expr": "height - 0.5"},
                       "depth": {"parameter": "depth"}, "storey": {"expr": "height + 0.05"}, "seed": {"parameter": "seed"},
                       "hangClear": {"expr": "select(awning, min(0.74 + awningLower, height - 2.1), 0)"}}}
    },
    {
      "id": "stock",
      "when": "open * stock",
      "generator": {"kind": "native", "name": "kowloon/street-stock",
        "parameters": {"width": {"parameter": "width"}, "seed": {"parameter": "seed"}}}
    },
    {
      "id": "clutter",
      "when": "cluttered",
      "generator": {"kind": "native", "name": "kowloon/street-stock",
        "parameters": {"width": {"derived": "clutterWidth"}, "seed": {"expr": "seed + 5"},
                       "kind": {"choose": ["crates", "crates", "crates", "cartons", "mixed"], "by": "select(clutter == 1, 2 + random(seed, 24) * 3, clutter)"}}},
      "placement": {"position": ["select(clutterOnRight, width / 2 + min(clutterRight, clutterWidth * 0.6) - clutterWidth / 2, -width / 2 - min(clutterLeft, clutterWidth * 0.6) + clutterWidth / 2)", 0, 0]}
    },
    {
      "id": "sign",
      "when": "signs * (1 - awning) * (kind != 2) * (kind != 4)",
      "generator": {"kind": "item", "entry": "kowloon-sign.item.json",
        "parameters": {"mount": "flat", "width": {"expr": "min(width * 0.62, 2.6)"}, "height": 0.3,
                       "scheme": {"choose": ["green", "red", "ivory", "blue", "black", "yellow"], "by": "random(seed, 21) * 6"},
                       "horizontal": true, "seed": {"parameter": "seed"}}},
      "placement": {"position": [0, 0, "height - 0.49"]}
    },
    {
      "id": "awning",
      "when": "awning * (awningKind == 0)",
      "generator": {"kind": "native", "name": "kowloon/awning",
        "parameters": {"width": {"derived": "awningWidth"}, "depth": 0.85, "drop": 0.3, "color": {"parameter": "awningColor"}, "seed": {"parameter": "seed"}}},
      "placement": {"position": [0, 0, {"derived": "awningZ"}]}
    },
    {
      "id": "tarp",
      "when": "awning * (awningKind >= 1)",
      "generator": {"kind": "native", "name": "kowloon/sagging-tarp",
        "parameters": {"width": {"derived": "awningWidth"}, "depth": {"expr": "select(awningKind == 2, 1.5, 1.35)"}, "drop": {"expr": "select(awningKind == 2, 0.42, 0.46)"},
                       "sag": {"expr": "select(awningKind == 2, awningSag * 0.25, awningSag)"}, "tilt": {"expr": "select(awningKind == 2, 0, 0.12)"},
                       "valance": {"expr": "select(awningKind == 2, 0.24, 0.16)"}, "scallops": {"expr": "select(awningKind == 2, awningBands / 2, 0)"},
                       "color": {"parameter": "awningColor"}, "hem": "#c9bca0",
                       "stripes": {"expr": "select(awningKind == 2, awningBands, 0)"}, "stripe": "#c9bca0",
                       "frame": {"choose": [false, true], "by": "awningKind - 1"},
                       "poles": {"expr": "select(awningKind == 2, 0, select(awningWidth > 4.2, 3, 2))"}, "stand": {"derived": "awningZ"},
                       "seed": {"parameter": "seed"}}},
      "placement": {"position": [0, 0, {"derived": "awningZ"}]}
    },
    {
      "id": "lamp",
      "when": "lamp",
      "generator": {"kind": "native", "name": "kowloon/wall-lamp", "parameters": {}},
      "placement": {"position": ["width / 2 + 0.05", 0, "height - 0.9"]}
    }
  ],
  "features": [
    {"name": "drip", "part": "awning", "points": [["-awningWidth / 2", 0, {"derived": "awningZ"}], ["awningWidth / 2", 0, {"derived": "awningZ"}]], "when": "awning * (awningKind == 0)"},
    {"name": "drip", "part": "tarp", "points": [["-awningWidth / 2", 0, {"derived": "awningZ"}], ["awningWidth / 2", 0, {"derived": "awningZ"}]], "when": "awning * (awningKind >= 1)"},
    {"name": "drip-above", "part": "awning", "points": [["-awningWidth / 2", 0, "height - 0.32"], ["awningWidth / 2", 0, "height - 0.32"]], "when": "awning * (awningKind == 0)"},
    {"name": "drip-above", "part": "tarp", "points": [["-awningWidth / 2", 0, "height - 0.32"], ["awningWidth / 2", 0, "height - 0.32"]], "when": "awning * (awningKind >= 1)"}
  ]
}
