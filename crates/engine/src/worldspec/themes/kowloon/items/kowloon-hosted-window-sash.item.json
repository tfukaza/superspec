{
  "format":"itemspec","version":2,"id":"kowloon-hosted-window-sash",
  "parameters":{
    "width":{"type":"number","default":0.954,"min":0.3,"max":3.91,"unit":"m"},
    "height":{"type":"number","default":1.104,"min":0.3,"max":2.91,"unit":"m"}
  },
  "parts":[
    {
      "id":"rail","repeat":[{"name":"end","count":2}],
      "generator":{"kind":"box","size":["width",0.032,0.035],"bevel":0.003,"bevelSegments":2,"bevelAxis":"x"},
      "placement":{"position":[0,0,"end * (height - 0.035)"]},
      "slots":{"top":"enamel","bottom":"enamel","side":"enamel"}
    },
    {
      "id":"stile","repeat":[{"name":"end","count":2}],
      "generator":{"kind":"box","size":["height - 0.070",0.032,0.035],"bevel":0.003,"bevelSegments":2,"bevelAxis":"x"},
      "placement":{"position":["0.035 + end * (width - 0.035)",0,0.035],"rotation":[0,-90,0]},
      "slots":{"top":"enamel","bottom":"enamel","side":"enamel"}
    },
    {
      "id":"glazing","generator":{"kind":"box","size":["width - 0.070",0.004,"height - 0.070"]},
      "placement":{"position":[0.035,0.013,0.035]},
      "slots":{"top":"glass","bottom":"glass","side":"glass"}
    },
    {
      "id":"meeting-rail","when":"height > 0.65","generator":{"kind":"box","size":["width - 0.070",0.022,0.020],"bevel":0.0025,"bevelSegments":2,"bevelAxis":"x"},
      "placement":{"position":[0.035,0.005,"height * 0.69"]},
      "slots":{"top":"enamel","bottom":"enamel","side":"enamel"}
    },
    {
      "id":"hinge-leaf","repeat":[{"name":"end","count":2}],
      "generator":{"kind":"box","size":[0.030,0.005,0.027],"bevel":0.001,"bevelAxis":"x"},
      "placement":{"position":[0,-0.005,"0.087 + end * (height - 0.201)"]},
      "slots":{"top":"hardware","bottom":"hardware","side":"hardware"}
    },
    {
      "id":"hinge-barrel","repeat":[{"name":"end","count":2}],
      "generator":{"kind":"route","section":{"kind":"round","radius":0.008},"segments":10,"points":[[0,0,0],[0,0,0.027]],"up":[0,1,0],"capped":true},
      "placement":{"position":[0,0,"0.087 + end * (height - 0.201)"]},
      "slots":{"body":"hardware","end":"hardware"}
    },
    {
      "id":"latch-base","generator":{"kind":"box","size":[0.019,0.010,0.047],"bevel":0.002,"bevelAxis":"z"},
      "placement":{"position":["width - 0.029",0.032,"height * 0.45"]},
      "slots":{"top":"hardware","bottom":"hardware","side":"hardware"}
    },
    {
      "id":"latch-lever","generator":{"kind":"route","section":{"kind":"round","radius":0.006},"segments":8,"points":[[0,0,0],[0,0.021,0],[-0.034,0.024,0],[-0.048,0.020,-0.009]],"up":[0,0,1],"bendRadius":0.008,"bendSegments":2,"capped":true},
      "placement":{"position":["width - 0.020",0.041,"height * 0.45 + 0.027"]},
      "slots":{"body":"hardware","end":"hardware"}
    }
  ],
  "slots":{"enamel":{"entry":"builtin:casement-enamel"},"glass":{"entry":"builtin:display-glass"},"hardware":{"entry":"builtin:casement-nickel"}},
  "collision":"mesh"
}
