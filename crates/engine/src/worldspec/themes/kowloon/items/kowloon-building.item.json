{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-building",
  "parameters": {
    "paint": {"type": "color", "default": "#e6d6b0"},
    "peeling": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "footprint": {"type": "points", "default": [[0, 0], [9.8, 0], [9.8, 7], [0, 7]]},
    "streets": {"type": "flags", "default": [true, true, false, false]},
    "cut": {"type": "number", "default": 0.24, "min": 0, "max": 3, "unit": "m"},
    "floors": {"type": "integer", "default": 4, "min": 2, "max": 12},
    "storyHeight": {"type": "number", "default": 3.0, "min": 2.6, "max": 4.5, "unit": "m"},
    "groundHeight": {"type": "number", "default": 3.35, "min": 2.6, "max": 6, "unit": "m"},
    "parapet": {"type": "number", "default": 0.75, "min": 0.3, "max": 2, "unit": "m"},
    "seed": {"type": "integer", "default": 3, "min": 0, "max": 100000},
    "frame": {"type": "color", "default": "#3f554b"},
    "signs": {"type": "boolean", "default": true},
    "rooftop": {"type": "boolean", "default": true},
    "shopWidth": {"type": "number", "default": 2.9, "min": 1.6, "max": 12, "unit": "m"},
    "streetWindowHeight": {"type": "number", "default": 1.75, "min": 0.5, "max": 2.4, "unit": "m"},
    "streetSill": {"type": "number", "default": 0.85, "min": 0.3, "max": 1.6, "unit": "m"},
    "boardPlans": {"type": "grid", "default": []},
    "boardTexts": {"type": "texts", "default": []},
    "spansPlans": {"type": "grid", "default": []},
    "windowsPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "window", "barred"]},
    "fixturesPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "aircon", "split", "cage", "rack", "plants"]},
    "shopPlans": {"type": "grid", "default": [], "choices": ["auto", "shop", "shutter", "gate", "door", "service"]},
    "awningPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "awning"]}
  },
  "derived": {
    "height": "groundHeight + (floors - 1) * storyHeight"
  },
  "parts": [
    {
      "id": "side",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}}],
      "when": "e_length >= 0.3",
      "generator": {"kind": "item", "entry": "kowloon-facade-side.item.json",
        "parameters": {"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"expr": "e_length"}, "floors": {"parameter": "floors"}, "storyHeight": {"parameter": "storyHeight"},
                       "groundHeight": {"parameter": "groundHeight"}, "parapet": {"parameter": "parapet"}, "seed": {"expr": "seed * 8 + e"},
                       "frame": {"parameter": "frame"},
                       "groundShops": {"choose": [false, true], "by": "e_street * (e_length >= 2.5)"},
                       "shopWidth": {"parameter": "shopWidth"}, "awningChance": 0.6,
                       "spansPlan": {"element": "spansPlans", "at": "e"}, "windowsPlan": {"element": "windowsPlans", "at": "e"}, "fixturesPlan": {"element": "fixturesPlans", "at": "e"},
                       "shopPlan": {"element": "shopPlans", "at": "e"}, "awningPlan": {"element": "awningPlans", "at": "e"},
                       "bayWidth": {"expr": "select(e_street, 2.35, 2.1)"}, "edge": {"expr": "select(e_street, 0.5, 0.9)"},
                       "windowWidth": {"expr": "select(e_street, 1.85, 0.9)"}, "windowHeight": {"expr": "select(e_street, streetWindowHeight, 1.1)"},
                       "sill": {"expr": "select(e_street, streetSill, 1.1)"},
                       "windowChance": {"expr": "select(e_street, 1, 0.35)"},
                       "barsChance": {"expr": "select(e_street, 0.5, 0.8)"}, "rackChance": {"expr": "select(e_street, 0.12, 0.35)"},
                       "airconChance": {"expr": "select(e_street, 0.4, 0.3)"}, "condenserChance": {"expr": "select(e_street, 0.3, 0.6)"},
                       "plantChance": {"expr": "select(e_street, 0.15, 0.05)"}, "ventChance": {"expr": "select(e_street, 0.2, 0.5)"},
                       "bands": {"choose": [false, true], "by": "e_street"},
                       "tileBands": {"choose": [false, true], "by": "e_street"}, "cageChance": {"expr": "select(e_street, 0.35, 0.1)"},
                       "balcony": {"choose": [false, true], "by": "e_street * (e_length > 8)"},
                       "backDoor": {"choose": [true, false], "by": "e_street"},
                       "pipes": {"expr": "select(e_street, 0, 3)"},
                       "riser": {"choose": [true, false], "by": "e_street"}, "riserRight": true,
                       "ductRun": {"choose": [true, false], "by": "e_street"}, "ducts": {"expr": "select(e_street, 0, 1)"}}},
      "placement": {"position": ["e_x", "e_y", 0], "along": ["e_dx", "e_dy"]}
    },
    {
      "id": "corner",
      "repeat": [{"name": "c", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}}],
      "when": "(c_cut > 0) * (c_clength >= 0.3)",
      "generator": {"kind": "item", "entry": "kowloon-facade-side.item.json",
        "parameters": {"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"expr": "c_clength"}, "floors": {"parameter": "floors"}, "storyHeight": {"parameter": "storyHeight"},
                       "groundHeight": {"parameter": "groundHeight"}, "parapet": {"parameter": "parapet"}, "seed": {"expr": "seed * 8 + 100 + c"},
                       "edge": 0.2, "windows": false, "groundShops": false, "downpipe": false, "riser": false}},
      "placement": {"position": ["c_cx", "c_cy", 0], "along": ["c_cdx", "c_cdy"]}
    },
    {
      "id": "cornerSign",
      "repeat": [{"name": "c", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}}],
      "when": "signs * (count(boardPlans) == 0) * (c_cut > 0)",
      "generator": {"kind": "native", "name": "kowloon/blade-sign",
        "parameters": {"height": {"expr": "storyHeight * 1.6"}, "reach": 1.3, "seed": {"expr": "seed * 7 + c"}}},
      "placement": {"position": ["c_cx + c_cdx * c_clength / 2", "c_cy + c_cdy * c_clength / 2", "groundHeight + 0.2"], "along": ["c_cdx", "c_cdy"]}
    },
    {
      "id": "streetSign",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}}],
      "when": "signs * (count(boardPlans) == 0) * e_street * (e_length > 6)",
      "generator": {"kind": "native", "name": "kowloon/hung-sign",
        "parameters": {"height": 2.4, "reach": 1.0, "seed": {"expr": "seed * 7 + 50 + e"}}},
      "placement": {"position": ["e_x + e_dx * e_length * 0.5", "e_y + e_dy * e_length * 0.5", "groundHeight + 0.3"], "along": ["e_dx", "e_dy"]}
    },
    {
      "id": "board",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}},
                 {"name": "k", "count": "count(boardPlans, e)"}],
      "generator": {"kind": "native", "name": "kowloon/board-sign",
        "parameters": {"text": {"element": "boardTexts", "at": "cell(boardPlans, e, k, 10)"},
                       "width": {"expr": "cell(boardPlans, e, k, 2)"}, "height": {"expr": "cell(boardPlans, e, k, 3)"},
                       "red": {"choose": [false, true], "by": "cell(boardPlans, e, k, 4)"},
                       "horizontal": {"choose": [false, true], "by": "cell(boardPlans, e, k, 5)"},
                       "angle": {"expr": "cell(boardPlans, e, k, 6)"}, "reach": {"expr": "cell(boardPlans, e, k, 7)"},
                       "anchor": {"expr": "cell(boardPlans, e, k, 8)"}, "end": {"expr": "cell(boardPlans, e, k, 9)"},
                       "seed": {"expr": "seed * 11 + e * 7 + k"}}},
      "placement": {"position": ["e_x + e_dx * cell(boardPlans, e, k, 0)", "e_y + e_dy * cell(boardPlans, e, k, 0)", "cell(boardPlans, e, k, 1)"],
                    "along": ["e_dx", "e_dy"]}
    },
    {
      "id": "roof",
      "generator": {"kind": "prism", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}}, "height": 0.22, "inset": 0.2},
      "placement": {"position": [0, 0, "height - 0.22"]},
      "slots": {"side": "wall", "top": "trim", "bottom": "wall"}
    },
    {
      "id": "rooftop",
      "repeat": [{"name": "r", "footprint": {"points": "footprint"}}],
      "when": "rooftop * (r == 0)",
      "generator": {"kind": "native", "name": "kowloon/rooftop",
        "parameters": {"width": {"expr": "(r_max_x - r_min_x) * 0.6"}, "depth": {"expr": "(r_max_y - r_min_y) * 0.6"},
                       "parapet": {"parameter": "parapet"}, "seed": {"parameter": "seed"}}},
      "placement": {"position": ["(r_min_x + r_max_x) / 2", "(r_min_y + r_max_y) / 2", {"derived": "height"}]}
    }
  ]
}
