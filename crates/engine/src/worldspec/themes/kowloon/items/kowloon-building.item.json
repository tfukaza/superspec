{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-building",
  "parameters": {
    "paint": {"type": "color", "default": "#c0b49e"},
    "peeling": {"type": "number", "default": 0.12, "min": 0, "max": 1},
    "footprint": {"type": "points", "default": [[0, 0], [9.8, 0], [9.8, 7], [0, 7]]},
    "streets": {"type": "flags", "default": [true, true, false, false]},
    "cut": {"type": "number", "default": 0.24, "min": 0, "max": 3, "unit": "m"},
    "cornerStyle": {"type": "choice", "default": "chamfer", "choices": ["chamfer", "round"]},
    "cornerSegments": {"type": "integer", "default": 8, "min": 2, "max": 16},
    "arris": {"type": "number", "default": 0.025, "min": 0, "max": 0.05, "unit": "m"},
    "cornerTiles": {"type": "boolean", "default": false},
    "floors": {"type": "integer", "default": 4, "min": 2, "max": 12},
    "storyHeight": {"type": "number", "default": 3.0, "min": 2.6, "max": 4.5, "unit": "m"},
    "groundHeight": {"type": "number", "default": 3.35, "min": 2.6, "max": 6, "unit": "m"},
    "parapet": {"type": "number", "default": 0.75, "min": 0.3, "max": 2, "unit": "m"},
    "seed": {"type": "integer", "default": 3, "min": 0, "max": 100000},
    "frame": {"type": "color", "default": "#6f7a6c"},
    "signs": {"type": "boolean", "default": true},
    "rooftop": {"type": "boolean", "default": false},
    "roofKit": {"type": "boolean", "default": true},
    "aerials": {"type": "integer", "default": 2, "min": 0, "max": 8},
    "roofRail": {"type": "boolean", "default": true},
    "roofRailShare": {"type": "number", "default": 0.55, "min": 0.1, "max": 1},
    "roofTiles": {"type": "boolean", "default": false},
    "pavementAround": {"type": "boolean", "default": false},
    "pavingStone": {"type": "number", "default": 0.55, "min": 0.2, "max": 2, "unit": "m"},
    "manholes": {"type": "boolean", "default": false},
    "spandrels": {"type": "boolean", "default": true},
    "dado": {"type": "number", "default": 0, "min": 0, "max": 2, "unit": "m"},
    "fullCages": {"type": "boolean", "default": false},
    "shutterColor": {"type": "color", "default": "#5a6f68"},
    "doorColor": {"type": "color", "default": "#2f4f43"},
    "plaquePlans": {"type": "grid", "default": []},
    "services": {"type": "boolean", "default": true},
    "spandrelPlans": {"type": "grid", "default": []},
    "awningLower": {"type": "number", "default": 0, "min": 0, "max": 1.2, "unit": "m"},
    "pavement": {"type": "boolean", "default": true},
    "pavementDepth": {"type": "number", "default": 1.45, "min": 0.4, "max": 10, "unit": "m"},
    "kerbHeight": {"type": "number", "default": 0.15, "min": 0.02, "max": 0.5, "unit": "m"},
    "plinth": {"type": "number", "default": 1.02, "min": 0, "max": 2, "unit": "m"},
    "plinthPlans": {"type": "grid", "default": []},
    "cornerPlinth": {"type": "number", "default": -1, "min": -1, "max": 2, "unit": "m"},
    "glazing": {"type": "boolean", "default": true},
    "hoods": {"type": "boolean", "default": true},
    "shopDepth": {"type": "number", "default": 3.1, "min": 2.4, "max": 20, "unit": "m"},
    "cornerClear": {"type": "number", "default": 0.5, "min": 0, "max": 20, "unit": "m"},
    "clutterPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "crates", "cartons", "mixed", "crates-left", "cartons-left", "mixed-left", "crates-right", "cartons-right", "mixed-right"]},
    "gateColor": {"type": "color", "default": "#647a6b"},
    "gateBars": {"type": "number", "default": 1, "min": 0.5, "max": 3},
    "gateBacking": {"type": "number", "default": 0, "min": 0, "max": 2},
    "doorPanels": {"type": "integer", "default": 0, "min": 0, "max": 4},
    "backDoorColor": {"type": "color", "default": "#2f4f43"},
    "backDoorLouvres": {"type": "boolean", "default": true},
    "conduits": {"type": "integer", "default": 1, "min": 0, "max": 6},
    "tradePlans": {"type": "grid", "default": [], "choices": ["auto", "provisions", "grocer", "greengrocer", "hardware", "herbalist"]},
    "shopSpansPlans": {"type": "grid", "default": []},
    "doorsPlans": {"type": "grid", "default": []},
    "canopiesPlans": {"type": "grid", "default": []},
    "pipePlans": {"type": "grid", "default": []},
    "conduitPlans": {"type": "grid", "default": []},
    "balconyPlans": {"type": "grid", "default": []},
    "shopWidth": {"type": "number", "default": 2.9, "min": 1.6, "max": 12, "unit": "m"},
    "streetWindowHeight": {"type": "number", "default": 1.75, "min": 0.5, "max": 2.4, "unit": "m"},
    "streetSill": {"type": "number", "default": 0.85, "min": 0.3, "max": 1.6, "unit": "m"},
    "boardPlans": {"type": "grid", "default": []},
    "boardTexts": {"type": "texts", "default": []},
    "spansPlans": {"type": "grid", "default": []},
    "windowsPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "window", "barred", "grille"]},
    "fixturesPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "aircon", "split", "cage", "rack", "plants", "caged-aircon"]},
    "fixtureAtPlans": {"type": "grid", "default": []},
    "cagedAircons": {"type": "number", "default": 0.4, "min": 0, "max": 1},
    "openChance": {"type": "number", "default": 0.3, "min": 0, "max": 8},
    "openPlans": {"type": "grid", "default": []},
    "litChance": {"type": "number", "default": 0.12, "min": 0, "max": 1},
    "litPlans": {"type": "grid", "default": []},
    "narrowBay": {"type": "number", "default": 0, "min": 0, "max": 10, "unit": "m"},
    "narrowLightWidth": {"type": "number", "default": 0.7, "min": 0.2, "max": 2, "unit": "m"},
    "louvreChance": {"type": "number", "default": 0.1, "min": 0, "max": 1},
    "louvrePlans": {"type": "grid", "default": [], "choices": ["auto", "none", "left", "right"]},
    "backWindowChance": {"type": "number", "default": 0.55, "min": 0, "max": 1},
    "backDoorPlans": {"type": "grid", "default": []},
    "shopPlans": {"type": "grid", "default": [], "choices": ["auto", "shop", "shutter", "gate", "door", "service", "open"]},
    "awningPlans": {"type": "grid", "default": [], "choices": ["auto", "none", "awning", "tarp", "striped"]},
    "awningSagPlans": {"type": "grid", "default": []},
    "awningStripePlans": {"type": "grid", "default": []},
    "conduitColor": {"type": "color", "default": "#4d5048"},
    "infill": {"type":"boolean", "default":false},
    "partyPlans": {"type": "grid", "default": [], "choices": ["none", "wall", "stub"]},
    "partyStoreyPlans": {"type": "grid", "default": []},
    "partyLanePlans": {"type": "grid", "default": []},
    "door": {"type": "choice", "default": "auto", "choices": ["auto", "single", "double", "glazed", "steel"]},
    "transom": {"type": "choice", "default": "auto", "choices": ["auto", "glazed", "mesh", "none"]},
    "fittedBays": {"type": "boolean", "default": false},
    "shutterHead": {"type": "number", "default": 0.22, "min": 0.1, "max": 1, "unit": "m"},
    "shutterHeadRust": {"type": "number", "default": 0, "min": 0, "max": 1},
    "meters": {"type": "boolean", "default": true},
    "bandsAround": {"type": "boolean", "default": false},
    "cagePlans": {"type": "grid", "default": [], "choices": ["auto", "plants", "washing", "storage", "mixed", "empty"]},
    "storagePlans": {"type": "grid", "default": []},
    "windowTransom": {"type": "number", "default": 0.84, "min": 0.5, "max": 0.95},
    "ventPlans": {"type": "grid", "default": []},
    "vents": {"type": "boolean", "default": true},
    "backPipes": {"type": "integer", "default": 3, "min": 0, "max": 8},
    "downpipes": {"type": "boolean", "default": true},
    "meterPlans": {"type": "grid", "default": []},
    "cables": {"type": "integer", "default": 2, "min": 0, "max": 12},
    "cablePlans": {"type": "grid", "default": []},
    "roofRailPlan": {"type": "grid", "default": []},
    "roofClutter": {"type": "number", "default": 0, "min": 0, "max": 1},
    "roofVentSide": {"type": "choice", "default": "right", "choices": ["left", "right", "front", "rear"]},
    "roofPipeSide": {"type": "choice", "default": "rear", "choices": ["left", "right", "front", "rear"]},
    "roofPotSide": {"type": "choice", "default": "front", "choices": ["left", "right", "front", "rear"]},
    "roofVentInset": {"type": "number", "default": 0.08, "min": 0.05, "max": 3, "unit": "m"},
    "tankRadius": {"type": "number", "default": 0.62, "min": 0.3, "max": 1.5, "unit": "m"},
    "tankHeight": {"type": "number", "default": 1.4, "min": 0.6, "max": 3, "unit": "m"},
    "tankStand": {"type": "number", "default": 0.72, "min": 0.2, "max": 3, "unit": "m"},
    "tankRibs": {"type": "integer", "default": 7, "min": 0, "max": 24},
    "tankLid": {"type": "number", "default": 0.24, "min": 0, "max": 1, "unit": "m"},
    "tankLadder": {"type": "number", "default": -1, "min": -1, "max": 360},
    "tankShell": {"type": "color", "default": "#f7f0e6"},
    "hutGrab": {"type": "number", "default": 1.0, "min": 0, "max": 1.5, "unit": "m"},
    "aerialHeight": {"type": "number", "default": 2.4, "min": 0.9, "max": 9, "unit": "m"},
    "aerialSize": {"type": "number", "default": 1.3, "min": 0.5, "max": 3},
    "aerialStays": {"type": "integer", "default": 3, "min": 0, "max": 4},
    "lampStyle": {"type": "choice", "default": "bulkhead", "choices": ["bulkhead", "round"]},
    "cageColor": {"type": "color", "default": "#c9c3b2"},
    "cageRust": {"type": "number", "default": 0.3, "min": 0, "max": 1},
    "cageBar": {"type": "number", "default": 0.018, "min": 0.004, "max": 0.05, "unit": "m"},
    "cageRail": {"type": "number", "default": 0.028, "min": 0.008, "max": 0.08, "unit": "m"},
    "cageSpacing": {"type": "number", "default": 0.22, "min": 0.04, "max": 0.5, "unit": "m"}
  },
  "derived": {
    "height": "groundHeight + (floors - 1) * storyHeight",
    "round": "cornerStyle * cornerSegments",
    "towerParty": "infill * (floors > 8) * (count(partyPlans) == 0)"
  },
  "parts": [
    {
      "id": "side",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}}],
      "when": "(e_length >= 0.3) * ((1 - e_street) * (cell(partyPlans, e) + towerParty * (1 - e_street)) != 1)",
      "generator": {"kind": "item", "entry": "kowloon-facade-side.item.json",
        "parameters": {"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"expr": "e_length"}, "u0": {"expr": "e_perimeter"}, "floors": {"parameter": "floors"}, "storyHeight": {"parameter": "storyHeight"},
                       "groundHeight": {"parameter": "groundHeight"}, "parapet": {"parameter": "parapet"}, "seed": {"expr": "seed * 8 + e"},
                       "frame": {"parameter": "frame"},
                       "groundShops": {"choose": [false, true], "by": "e_street * (e_length >= 2.5)"},
                       "shopWidth": {"parameter": "shopWidth"}, "awningChance": 0.6,
                       "spansPlan": {"element": "spansPlans", "at": "e"}, "windowsPlan": {"element": "windowsPlans", "at": "e"}, "fixturesPlan": {"element": "fixturesPlans", "at": "e"},
                       "shopPlan": {"element": "shopPlans", "at": "e"}, "awningPlan": {"element": "awningPlans", "at": "e"},
                       "awningSagPlan": {"element": "awningSagPlans", "at": "e"}, "awningStripePlan": {"element": "awningStripePlans", "at": "e"},
                       "tradePlan": {"element": "tradePlans", "at": "e"}, "shopSpans": {"element": "shopSpansPlans", "at": "e"},
                       "doorsPlan": {"element": "doorsPlans", "at": "e"}, "canopiesPlan": {"element": "canopiesPlans", "at": "e"}, "canopyChance": {"expr": "select(e_street, 0.25, 0.1)"}, "pipePlan": {"element": "pipePlans", "at": "e"},
                       "conduitPlan": {"element": "conduitPlans", "at": "e"}, "conduits": {"expr": "select(e_street, conduits, 0)"}, "conduitColor": {"parameter": "conduitColor"},
                       "shopDepth": {"parameter": "shopDepth"}, "shopSigns": {"parameter": "signs"},
                       "cornerStart": {"expr": "select(e_street * e_previous_street, shopDepth - cut + 0.1, 0)"}, "cornerDepth": {"expr": "cut + cornerClear - 0.1"},
                       "clutterPlan": {"element": "clutterPlans", "at": "e"}, "gateColor": {"parameter": "gateColor"},
                       "gateBars": {"parameter": "gateBars"}, "gateBacking": {"parameter": "gateBacking"}, "doorPanels": {"parameter": "doorPanels"},
                       "backDoorColor": {"parameter": "backDoorColor"}, "backDoorLouvres": {"parameter": "backDoorLouvres"},
                       "glazing": {"parameter": "glazing"}, "hoods": {"parameter": "hoods"},
                       "plinth": {"expr": "select(count(plinthPlans) > e, cell(plinthPlans, e), select(e_street, plinth, 0))"}, "ledge": {"choose": [false, true], "by": "e_street"},
                       "miterStart": {"expr": "select((round > 0) * (e_previous_cut > 0), 0, e_miter_start)"},
                       "miterEnd": {"expr": "select((round > 0) * (e_cut > 0), 0, e_miter_end)"}, "joinWalls": true,
                       "copingFlush": {"choose": [false, true], "by": "round > 0"},
                       "arris": {"parameter": "arris"}, "arrisStart": {"expr": "select(e_previous_cut > 0, 0, select(e_miter_start <= 2, max(0, e_miter_start), 0))"}, "arrisEnd": {"expr": "select(e_cut > 0, 0, select(e_miter_end <= 2, max(0, e_miter_end), 0))"},
                       "tileStart": {"choose": [false, true], "by": "cornerTiles * (e_previous_cut > 0)"}, "tileEnd": {"choose": [false, true], "by": "cornerTiles * (e_cut > 0)"},
                       "door": {"parameter": "door"}, "transom": {"parameter": "transom"}, "fitted": {"parameter": "fittedBays"}, "lampStyle": {"parameter": "lampStyle"},
                       "shutterHead": {"parameter": "shutterHead"}, "shutterHeadRust": {"parameter": "shutterHeadRust"}, "meters": {"parameter": "meters"},
                       "fascia": {"choose": [true, false], "by": "bandsAround"},
                       "cagesPlan": {"element": "cagePlans", "at": "e"}, "storagePlan": {"element": "storagePlans", "at": "e"}, "windowTransom": {"parameter": "windowTransom"},
                       "ventPlan": {"element": "ventPlans", "at": "e"}, "downpipe": {"parameter": "downpipes"},
                       "meterPlan": {"element": "meterPlans", "at": "e"}, "cablePlan": {"element": "cablePlans", "at": "e"},
                       "cables": {"expr": "select(e_street, cables, select((cell(partyPlans, e) + towerParty * (1 - e_street)) > 0, 0, min(1, cables)))"}, "cornerRadius": {"expr": "select(e_street * (e_cut > 0), e_cut, 0)"},
                       "balconyFrom": {"expr": "select(count(balconyPlans, e) >= 2, cell(balconyPlans, e, 0), 0.6)"},
                       "balconyTo": {"expr": "select(count(balconyPlans, e) >= 2, cell(balconyPlans, e, 1), -0.6)"},
                       "balconyDepth": {"expr": "select(count(balconyPlans, e) >= 3, cell(balconyPlans, e, 2), 1.0)"},
                       "balconyFan": {"expr": "select(count(balconyPlans, e) >= 4, cell(balconyPlans, e, 3), -1)"},
                       "bayWidth": {"expr": "select(towerParty, max(select(e_street, 2.35, 2.1), min(4, (e_length - select(e_street, 1, 1.8)) / 3)), select(e_street, 2.35, 2.1))"}, "edge": {"expr": "select(e_street, 0.5, 0.9)"},
                       "windowWidth": {"expr": "select(e_street, 1.85, 0.9)"}, "windowHeight": {"expr": "select(e_street, streetWindowHeight, 1.1)"},
                       "sill": {"expr": "select(e_street, streetSill, 1.1)"},
                       "windowChance": {"expr": "select(e_street, 1, backWindowChance)"},
                       "fixturesAt": {"element": "fixtureAtPlans", "at": "e"}, "cagedChance": {"expr": "select(e_street, cagedAircons, min(1, cagedAircons * 2))"},
                       "openChance": {"parameter": "openChance"}, "opensPlan": {"element": "openPlans", "at": "e"},
                       "litChance": {"parameter": "litChance"}, "litsPlan": {"element": "litPlans", "at": "e"},
                       "narrowBay": {"parameter": "narrowBay"}, "narrowLightWidth": {"parameter": "narrowLightWidth"},
                       "louvreChance": {"parameter": "louvreChance"}, "louvresPlan": {"element": "louvrePlans", "at": "e"},
                       "backDoorAt": {"expr": "cell(backDoorPlans, e)"},
                       "barsChance": {"expr": "select(e_street, 0.5, 0.8)"}, "rackChance": {"expr": "select(e_street, 0.12, 0.35)"},
                       "airconChance": {"expr": "select(e_street, 0.4, 0.45)"}, "condenserChance": {"expr": "select(e_street, 0.3, 0.45)"},
                       "plantChance": {"expr": "select(e_street, 0.15, 0.05)"}, "ventChance": {"expr": "select(e_street, 0.2, 0.5) * vents"},
                       "bands": {"choose": [false, true], "by": "min(1, e_street + bandsAround)"},
                       "tileBands": {"choose": [false, true], "by": "e_street * spandrels"},
                       "dado": {"parameter": "dado"}, "awningLower": {"parameter": "awningLower"}, "spandrelsPlan": {"element": "spandrelPlans", "at": "e"}, "fullCages": {"parameter": "fullCages"}, "cageColor": {"parameter": "cageColor"}, "cageRust": {"parameter": "cageRust"}, "cageBar": {"parameter": "cageBar"}, "cageRail": {"parameter": "cageRail"}, "cageSpacing": {"parameter": "cageSpacing"}, "shutterColor": {"parameter": "shutterColor"}, "doorColor": {"parameter": "doorColor"}, "cageChance": {"expr": "select(e_street, 0.35, 0.1)"},
                       "balcony": {"choose": [false, true], "by": "e_street * (e_length > 8)"},
                       "backDoor": {"choose": [true, false], "by": "min(1, e_street + ((cell(partyPlans, e) + towerParty * (1 - e_street)) > 0))"},
                       "pipes": {"expr": "select(e_street, 0, backPipes)"},
                       "riser": {"choose": [false, true], "by": "services * (1 - e_street)"}, "riserRight": {"choose": [true, false], "by": "e_next_street"},
                       "ductRun": {"choose": [false, true], "by": "services * (1 - e_street)"}, "ducts": {"expr": "select(e_street, 0, services)"}}},
      "placement": {"position": ["e_x", "e_y", 0], "along": ["e_dx", "e_dy"]}
    },
    {
      "id": "corner",
      "repeat": [{"name": "c", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}}],
      "when": "(round == 0) * (c_cut > 0) * (c_clength >= 0.3)",
      "generator": {"kind": "item", "entry": "kowloon-facade-side.item.json",
        "parameters": {"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"},"width": {"expr": "c_clength"}, "u0": {"expr": "c_cperimeter"}, "floors": {"parameter": "floors"}, "storyHeight": {"parameter": "storyHeight"},
                       "groundHeight": {"parameter": "groundHeight"}, "parapet": {"parameter": "parapet"}, "seed": {"expr": "seed * 8 + 100 + c"},
                       "edge": 0.2, "windows": false, "groundShops": false, "downpipe": false, "riser": false,
                       "sill": {"parameter": "streetSill"}, "tileStrip": {"parameter": "cornerTiles"},
                       "plinth": {"expr": "select(cornerPlinth >= 0, cornerPlinth, plinth)"}, "ledge": true,
                       "miterStart": {"expr": "c_cmiter_start"}, "miterEnd": {"expr": "c_cmiter_end"}, "joinWalls": true}},
      "placement": {"position": ["c_cx", "c_cy", 0], "along": ["c_cdx", "c_cdy"]}
    },
    {
      "id": "cornerRound",
      "repeat": [{"name": "c", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}}],
      "when": "(round > 0) * (c_cut > 0)",
      "generator": {"kind": "item", "entry": "kowloon-corner.item.json",
        "parameters": {"paint": {"parameter": "paint"}, "peeling": {"parameter": "peeling"}, "u0": {"expr": "c_cperimeter"},
                       "radius": {"expr": "c_cradius"}, "turn": {"expr": "c_turn"}, "segments": {"derived": "round"},
                       "floors": {"parameter": "floors"}, "storyHeight": {"parameter": "storyHeight"},
                       "groundHeight": {"parameter": "groundHeight"}, "parapet": {"parameter": "parapet"},
                       "sill": {"parameter": "streetSill"}, "tileStrip": {"parameter": "cornerTiles"},
                       "plinth": {"expr": "select(cornerPlinth >= 0, cornerPlinth, plinth)"}}},
      "placement": {"position": ["c_cx", "c_cy", 0], "along": ["c_dx", "c_dy"]}
    },
    {
      "id": "cornerSign",
      "repeat": [{"name": "c", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}}],
      "when": "signs * (count(boardPlans) == 0) * (c_cut > 0)",
      "generator": {"kind": "item", "entry": "kowloon-sign.item.json",
        "parameters": {"mount": "blade", "height": {"expr": "storyHeight * 1.6"}, "reach": 1.3, "seed": {"expr": "seed * 7 + c"}}},
      "placement": {"position": ["c_cx + c_cdx * c_clength / 2", "c_cy + c_cdy * c_clength / 2", "groundHeight + 0.2"], "along": ["c_cdx", "c_cdy"]}
    },
    {
      "id": "streetSign",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}}],
      "when": "signs * (count(boardPlans) == 0) * e_street * (e_length >= 4)",
      "generator": {"kind": "item", "entry": "kowloon-sign.item.json",
        "parameters": {"mount": "board", "angle": 90, "height": {"expr": "min(storyHeight, 2.4 + 0.4 * random(seed, e, 87))"}, "width": 0.82, "reach": 0.85,
                       "text": {"choose": ["永昌藥行", "興隆五金", "電器修理", "廣源雜貨"], "by": "(seed + e) % 4"},
                       "design": {"choose": ["pharmacy", "hardware", "electrical", "grocery"], "by": "(seed + e) % 4"},
                       "scheme": {"choose": ["ivory", "red", "blue", "green"], "by": "(seed + e) % 4"},
                       "seed": {"expr": "seed * 7 + 50 + e"}}},
      "placement": {"position": ["e_x + e_dx * e_length * 0.18", "e_y + e_dy * e_length * 0.18", "groundHeight + 0.3"], "along": ["e_dx", "e_dy"]}
    },
    {
      "id": "board",
      "repeat": [{"name": "e", "footprint": {"points": "footprint", "streets": "streets", "cut": {"parameter": "cut"}, "round": {"derived": "round"}}},
                 {"name": "k", "count": "count(boardPlans, e)"}],
