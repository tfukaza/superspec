{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-roof",
  "parameters": {
    "width": {"type": "number", "default": 9, "min": 1, "max": 40, "unit": "m"},
    "depth": {"type": "number", "default": 7, "min": 1, "max": 40, "unit": "m"},
    "thickness": {"type": "number", "default": 0.22, "min": 0.1, "max": 0.6, "unit": "m"},
    "inset": {"type": "number", "default": 0.3, "min": 0, "max": 2, "unit": "m"},
    "rooftop": {"type": "boolean", "default": true},
    "parapet": {"type": "number", "default": 0.95, "min": 0, "max": 3, "unit": "m"},
    "seed": {"type": "integer", "default": 1, "min": 0, "max": 100000}
  },
  "parts": [
    {
      "id": "slab",
      "generator": {"kind": "box", "size": [{"parameter": "width"}, {"parameter": "depth"}, {"parameter": "thickness"}]},
      "placement": {"position": [0, 0, "-thickness"]},
      "slots": {"side": "wall", "top": "trim", "bottom": "wall"}
    },
    {
      "id": "rooftop",
      "when": "rooftop",
      "generator": {"kind": "native", "name": "kowloon/rooftop",
        "parameters": {"width": {"expr": "width - inset * 2"}, "depth": {"expr": "depth - inset * 2"},
                       "parapet": {"parameter": "parapet"}, "seed": {"parameter": "seed"}}},
      "placement": {"position": ["width / 2", "depth / 2", 0]}
    }
  ]
}
