{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-sign",
  "densities": {"lettering": 800, "board": 320},
  "parameters": {
    "mount": {"type": "choice", "default": "board", "choices": ["board", "blade", "hung", "flat"]},
    "width": {"type": "number", "default": 0.94, "min": 0.2, "max": 8, "unit": "m"},
    "height": {"type": "number", "default": 3.3, "min": 0.1, "max": 12, "unit": "m"},
    "text": {"type": "text", "default": ""},
    "scheme": {"type": "choice", "default": "red", "choices": ["ivory", "red", "green", "blue", "yellow", "black", "white"]},
    "horizontal": {"type": "boolean", "default": false},
    "angle": {"type": "number", "default": 0, "min": -80, "max": 80, "unit": "deg"},
    "reach": {"type": "number", "default": 0.8, "min": 0.05, "max": 4, "unit": "m"},
    "anchor": {"type": "number", "default": 0, "min": -8, "max": 8, "unit": "m"},
    "end": {"type": "number", "default": -100, "min": -100, "max": 8, "unit": "m"},
    "ties": {"type": "boolean", "default": true},
    "panels": {"type": "integer", "default": 0, "min": 0, "max": 24},
    "panel": {"type": "color", "default": "#d2a23a"},
    "panel2": {"type": "color", "default": "#d2a23a"},
    "age": {"type": "number", "default": 0.7, "min": 0, "max": 1},
    "seed": {"type": "integer", "default": 0, "min": 0, "max": 100000000}
  },
  "parts": [
    {
      "id": "board",
      "when": "mount == 0",
      "generator": {"kind": "native", "name": "kowloon/board-sign",
        "parameters": {"text": {"parameter": "text"}, "width": {"parameter": "width"}, "height": {"parameter": "height"},
                       "scheme": {"parameter": "scheme"}, "horizontal": {"parameter": "horizontal"},
                       "angle": {"parameter": "angle"}, "reach": {"parameter": "reach"}, "anchor": {"parameter": "anchor"},
                       "end": {"expr": "select(end <= -99, width, end)"}, "ties": {"parameter": "ties"},
                       "panels": {"parameter": "panels"}, "panel": {"parameter": "panel"}, "panel2": {"parameter": "panel2"},
                       "age": {"parameter": "age"}, "seed": {"parameter": "seed"}}}
    },
    {
      "id": "blade",
      "when": "mount == 1",
      "generator": {"kind": "native", "name": "kowloon/blade-sign",
        "parameters": {"height": {"parameter": "height"}, "reach": {"parameter": "reach"}, "seed": {"parameter": "seed"}}}
    },
    {
      "id": "hung",
      "when": "mount == 2",
      "generator": {"kind": "native", "name": "kowloon/hung-sign",
        "parameters": {"height": {"parameter": "height"}, "reach": {"parameter": "reach"}, "seed": {"parameter": "seed"}}}
    },
    {
      "id": "flat",
      "when": "mount == 3",
      "generator": {"kind": "native", "name": "kowloon/sign",
        "parameters": {"width": {"parameter": "width"}, "height": {"parameter": "height"}, "text": {"parameter": "text"}, "invent": true, "subtitle": "",
                       "ground": {"choose": ["#dfcfaa", "#793f32", "#2f5a48", "#2c4a6e", "#d2a23a", "#1f1d1b", "#dcd8cc"], "by": "scheme"},
                       "ink": {"choose": ["#793f32", "#dfcfaa", "#e9d9a8", "#e8e2d0", "#4a1d17", "#d9b65a", "#8a4a2c"], "by": "scheme"},
                       "border": {"choose": ["#793f32", "#dfcfaa", "#e9d9a8", "#e8e2d0", "#4a1d17", "#d9b65a", "#8a4a2c"], "by": "scheme"},
                       "direction": {"choose": ["ttb", "ltr"], "by": "horizontal"}, "shadow": false,
                       "age": {"parameter": "age"}, "seed": {"parameter": "seed"}}}
    }
  ],
  "features": [
    {"name": "top", "part": "board", "points": [[0, "-reach", {"parameter": "height"}], [{"parameter": "width"}, "-reach", {"parameter": "height"}]], "when": "(mount == 0) * (angle == 0)"},
    {"name": "fixing", "part": "board", "points": [[{"parameter": "anchor"}, 0, 0.04], [{"parameter": "anchor"}, 0, 0.2]], "when": "mount == 0"},
    {"name": "fixing", "part": "board", "points": [[{"parameter": "anchor"}, 0, "height - 0.2"], [{"parameter": "anchor"}, 0, "height - 0.04"]], "when": "mount == 0"},
    {"name": "top", "part": "flat", "points": [["-width / 2", 0, {"parameter": "height"}], ["width / 2", 0, {"parameter": "height"}]], "when": "mount == 3"}
  ]
}
