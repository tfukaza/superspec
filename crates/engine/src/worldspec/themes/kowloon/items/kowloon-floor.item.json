{
  "format": "itemspec",
  "version": 2,
  "id": "kowloon-floor",
  "parameters": {
    "width": {"type": "number", "default": 9, "min": 0.3, "max": 40, "unit": "m"},
    "height": {"type": "number", "default": 3.0, "min": 2.4, "max": 5, "unit": "m"},
    "thickness": {"type": "number", "default": 0.25, "min": 0.1, "max": 0.6, "unit": "m"},
    "z0": {"type": "number", "default": 0, "min": 0, "max": 200, "unit": "m"},
    "level": {"type": "integer", "default": 1, "min": 0, "max": 100},
    "seed": {"type": "integer", "default": 1, "min": 0, "max": 100000},
    "windows": {"type": "boolean", "default": true},
    "windowChance": {"type": "number", "default": 1, "min": 0, "max": 1},
    "bayWidth": {"type": "number", "default": 2.1, "min": 1.0, "max": 6, "unit": "m"},
    "edge": {"type": "number", "default": 0.9, "min": 0.2, "max": 3, "unit": "m"},
    "windowWidth": {"type": "number", "default": 1.1, "min": 0.5, "max": 3, "unit": "m"},
    "windowHeight": {"type": "number", "default": 1.3, "min": 0.5, "max": 2.4, "unit": "m"},
    "sill": {"type": "number", "default": 0.95, "min": 0.3, "max": 1.6, "unit": "m"},
    "windowKind": {"type": "choice", "default": "casement", "choices": ["casement", "slider", "timber", "louver"]},
    "frame": {"type": "color", "default": "#2f4f43"},
    "airconChance": {"type": "number", "default": 0.5, "min": 0, "max": 1},
    "condenserChance": {"type": "number", "default": 0.35, "min": 0, "max": 1},
    "barsChance": {"type": "number", "default": 0, "min": 0, "max": 1},
    "ventChance": {"type": "number", "default": 0.25, "min": 0, "max": 1},
    "rackChance": {"type": "number", "default": 0.15, "min": 0, "max": 1},
    "plantChance": {"type": "number", "default": 0.12, "min": 0, "max": 1},
    "band": {"type": "boolean", "default": true}
  },
  "derived": {
    "bays": "select(windows, max(1, floor((width - edge * 2) / bayWidth)), 0)",
    "start": "(width - bays * bayWidth) / 2",
    "inset": "(bayWidth - windowWidth) / 2"
  },
  "parts": [
    {
      "id": "wall",
      "generator": {
        "kind": "panel",
        "width": {"parameter": "width"},
        "height": {"parameter": "height"},
        "thickness": {"parameter": "thickness"},
        "patternAnchor": [0, "-z0"],
        "openings": [
          {"id": "window", "repeat": {"name": "i", "count": {"derived": "bays"}}, "when": "random(seed, level, i, 11) < windowChance",
           "width": {"parameter": "windowWidth"}, "height": {"parameter": "windowHeight"},
           "u": {"from": "start", "offset": "start + i * bayWidth + inset"}, "v": {"from": "start", "offset": {"parameter": "sill"}}}
        ]
      },
      "slots": {"front": "wall", "back": "wall", "edge": "wall", "reveal": "wall"}
    },
    {
      "id": "window",
      "repeat": [{"name": "i", "count": {"derived": "bays"}}],
      "when": "random(seed, level, i, 11) < windowChance",
      "generator": {"kind": "item", "entry": "kowloon-window.item.json",
        "parameters": {"width": {"parameter": "windowWidth"}, "height": {"parameter": "windowHeight"}, "kind": {"parameter": "windowKind"},
                       "frame": {"parameter": "frame"}, "recess": {"expr": "min(0.3, thickness - 0.02)"},
                       "seed": {"expr": "seed * 1000 + level * 37 + i"},
                       "bars": {"choose": [false, true], "by": "random(seed, level, i, 3) < barsChance"},
                       "barsPattern": {"choose": ["bars", "grid", "diamond"], "by": "random(seed, i, 6) * 3"}}},
      "placement": {"position": ["start + i * bayWidth + bayWidth / 2", 0, {"parameter": "sill"}]}
    },
    {
      "id": "aircon",
      "repeat": [{"name": "i", "count": {"derived": "bays"}}],
      "when": "random(seed, level, i, 1) < airconChance + condenserChance",
      "generator": {"kind": "item", "entry": "kowloon-aircon.item.json",
        "parameters": {"split": {"choose": [false, true], "by": "random(seed, level, i, 1) >= airconChance"},
                       "seed": {"expr": "seed * 1000 + level * 37 + i"}}},
      "placement": {"position": ["start + i * bayWidth + bayWidth / 2", 0, "sill - 0.72"]}
    },
    {
      "id": "vent",
      "repeat": [{"name": "i", "count": {"derived": "bays"}}],
      "when": "random(seed, level, i, 4) < ventChance",
      "generator": {"kind": "native", "name": "kowloon/wall-vent", "parameters": {}},
      "placement": {"position": ["start + i * bayWidth + bayWidth / 2 + windowWidth / 2 + 0.26", 0, "sill + windowHeight - 0.3"]}
    },
    {
      "id": "rack",
      "repeat": [{"name": "i", "count": {"derived": "bays"}}],
      "when": "(random(seed, level, i, 11) < windowChance) * (random(seed, level, i, 8) < rackChance)",
      "generator": {"kind": "native", "name": "kowloon/drying-rack",
        "parameters": {"width": {"expr": "windowWidth + 0.3"}, "depth": 0.55, "seed": {"expr": "seed * 1000 + level * 37 + i"}}},
      "placement": {"position": ["start + i * bayWidth + bayWidth / 2", 0, "sill + windowHeight + 0.12"]}
    },
    {
      "id": "plants",
      "repeat": [{"name": "i", "count": {"derived": "bays"}}],
      "when": "(random(seed, level, i, 11) < windowChance) * (random(seed, level, i, 8) >= rackChance) * (random(seed, level, i, 9) < plantChance)",
      "generator": {"kind": "native", "name": "kowloon/plants",
        "parameters": {"width": {"expr": "windowWidth - 0.1"}, "offset": 0.14, "seed": {"expr": "seed * 1000 + level * 37 + i"}}},
      "placement": {"position": ["start + i * bayWidth + bayWidth / 2", 0, "sill + 0.03"]}
    },
    {
      "id": "band",
      "when": "band",
      "generator": {"kind": "box", "size": [{"parameter": "width"}, 0.1, 0.16]},
      "placement": {"position": [0, -0.1, -0.08]},
      "slots": {"side": "trim", "top": "trim", "bottom": "trim"}
    }
  ],

  "layers": {
    "wall": [
      {"entry": "kowloon-top-grime.material.ts", "parameters": {"amount": 0.45}, "seed": 3, "follow": {}},
      {"entry": "kowloon-top-grime.material.ts", "parameters": {"amount": 0.6}, "seed": 5, "follow": {"top": "sill"}},
      {"entry": "kowloon-top-grime.material.ts", "parameters": {"amount": 0.85}, "seed": 7, "follow": {"top": "drip"}}
    ]
  }
}
