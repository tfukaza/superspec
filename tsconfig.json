{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "esModuleInterop": true
  },
  "include": [
    "editor/**/*.ts",
    "browser/**/*.ts",
    "tests/browser/rust*.ts",
    "tests/browser/bake-graph*.ts",
    "vite.rust.config.ts"
  ]
}
